{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sully.local/schemas/modpack-manifest-v1.json",
  "title": "Sully custom migration pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "upstream", "modules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["inventory-only", "mixed"] },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineCommit", "formalReleasePath"],
      "properties": {
        "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "formalReleasePath": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "manifest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "enum": ["inventory", "ready"] },
          "manifest": { "type": "string", "pattern": "^modules/[a-z0-9-]+/manifest\\.json$" }
        }
      }
    }
  }
}
