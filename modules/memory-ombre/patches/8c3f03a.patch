+    return { ...node, content: serializeStableCognition({ ...existing, conclusion, conditions, counterexamples: cleanLine(input.counterexamples || '\u6682\u65e0', 500), revisedAt: new Date(now).toISOString() }), archived: true, embedded: false };
+}
+export function downgradeStableCognition(node: MemoryNode): MemoryNode { if (!isStableCognitionRecord(node)) throw new Error('\u8fd9\u4e0d\u662f\u7a33\u5b9a\u8ba4\u77e5\u8bb0\u5f55'); return { ...node, tags: node.tags.includes(STABLE_COGNITION_DOWNGRADED_TAG) ? node.tags : [...node.tags, STABLE_COGNITION_DOWNGRADED_TAG], archived: true, embedded: false }; }
