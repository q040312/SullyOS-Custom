@@ -0,0 +1,308 @@
+import type { MemoryNode } from './types';
+
+export const ROLLING_CYCLE_NODE_LIMIT = 150;
+export const ROLLING_CYCLE_MAX_AGE_MS = 3 * 24 * 60 * 60 * 1000;
+export const ROLLING_CYCLE_STATE_VERSION = 1;
+
+const STATE_KEY = (charId: string) => `mp_cycle_state_${charId}`;
+const ENABLED_KEY = 'mp_rolling_cycles_enabled';
+const processLocks = new Map<string, Promise<void>>();
+
+export type RollingCycleStatus =
+    | 'collecting'
+    | 'preparing'
+    | 'uploading'
+    | 'verifying'
+    | 'committed'
+    | 'cleaned'
+    | 'failed';
+
+export interface RollingCycleRecord {
+    id: string;
+    charId: string;
+    status: RollingCycleStatus;
+    startedAt: number;
+    startHighWaterMark: number;
+    closedAt: number | null;
+    committedAt: number | null;
+    cleanedAt: number | null;
+    candidateCount: number;
+    uploadedCount: number;
+    remoteBucketIds: string[];
+    /** Exact local snapshot eligible for cleanup after a verified commit. */
+    committedNodeIds: string[];
+    /** Distinguishes a verified empty snapshot from legacy state with no snapshot ledger. */
+    cleanupSnapshotRecorded: boolean;
+    error: string | null;
+}
+
+export interface RollingCycleState {
+    version: number;
+    charId: string;
+    active: RollingCycleRecord;
+    history: RollingCycleRecord[];
+}
+
+export interface RollingCycleTrigger {
+    due: boolean;
+    reason: 'node_limit' | 'age_limit' | null;
+    nodeCount: number;
+    ageMs: number;
+    nodeLimit: number;
+    maxAgeMs: number;
+}
+
+function storage(): Storage | null {
+    try {
+        return typeof localStorage === 'undefined' ? null : localStorage;
+    } catch {
+        return null;
+    }
+}
+
+function makeCycleId(charId: string, now: number): string {
+    const stamp = new Date(now).toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);
+    return `cycle_${charId}_${stamp}`;
+}
+
+export function createRollingCycle(
+    charId: string,
+    startHighWaterMark: number,
+    now = Date.now(),
+): RollingCycleRecord {
+    return {
+        id: makeCycleId(charId, now),
+        charId,
+        status: 'collecting',
+        startedAt: now,
+        startHighWaterMark: Math.max(0, startHighWaterMark || 0),
+        closedAt: null,
+        committedAt: null,
+        cleanedAt: null,
+        candidateCount: 0,
+        uploadedCount: 0,
+        remoteBucketIds: [],
+        committedNodeIds: [],
+        cleanupSnapshotRecorded: false,
+        error: null,
+    };
+}
+
+export function isRollingCycleBuild(): boolean {
+    return import.meta.env.VITE_MEMORY_ROLLING_CYCLES === '1';
+}
+
+export function isRollingCycleEnabled(): boolean {
+    if (!isRollingCycleBuild()) return false;
+    const value = storage()?.getItem(ENABLED_KEY);
+    return value !== 'false';
+}
+
+export function setRollingCycleEnabled(enabled: boolean): void {
+    storage()?.setItem(ENABLED_KEY, enabled ? 'true' : 'false');
+}
+
+export function readRollingCycleState(charId: string): RollingCycleState | null {
+    const raw = storage()?.getItem(STATE_KEY(charId));
+    if (!raw) return null;
+    try {
+        const parsed = JSON.parse(raw) as RollingCycleState;
+        if (
+            parsed?.version !== ROLLING_CYCLE_STATE_VERSION
+            || parsed?.charId !== charId
+            || !parsed?.active?.id
+        ) return null;
+        const normalizeRecord = (record: RollingCycleRecord): RollingCycleRecord => ({
+            ...record,
+            committedNodeIds: Array.isArray(record.committedNodeIds)
+                ? record.committedNodeIds
+                : [],
+            cleanupSnapshotRecorded: record.cleanupSnapshotRecorded === true,
+        });
+        return {
+            ...parsed,
+            active: normalizeRecord(parsed.active),
+            history: Array.isArray(parsed.history)
+                ? parsed.history.map(normalizeRecord)
+                : [],
+        };
+    } catch {
+        return null;
+    }
+}
+
+export function writeRollingCycleState(state: RollingCycleState): void {
+    storage()?.setItem(STATE_KEY(state.charId), JSON.stringify(state));
+}
+
+export async function withRollingCycleLock<T>(
+    charId: string,
+    task: () => Promise<T>,
+): Promise<T> {
+    const lockName = `sully-memory-rolling-cycle:${charId}`;
+    const webLocks = typeof navigator !== 'undefined'
+        ? (navigator as any).locks
+        : undefined;
+    if (webLocks?.request) {
+        return webLocks.request(lockName, { mode: 'exclusive' }, task);
+    }
+
+    const previous = processLocks.get(lockName) || Promise.resolve();
+    let release!: () => void;
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    const tail = previous.then(() => gate);
+    processLocks.set(lockName, tail);
+    await previous;
+    try {
+        return await task();
+    } finally {
+        release();
+        if (processLocks.get(lockName) === tail) processLocks.delete(lockName);
+    }
+}
+
+export function ensureRollingCycleState(
+    charId: string,
+    startHighWaterMark: number,
+    now = Date.now(),
+): RollingCycleState {
+    const existing = readRollingCycleState(charId);
+    if (existing) return existing;
+    const state: RollingCycleState = {
+        version: ROLLING_CYCLE_STATE_VERSION,
+        charId,
+        active: createRollingCycle(charId, startHighWaterMark, now),
+        history: [],
+    };
+    writeRollingCycleState(state);
+    return state;
+}
+
+export function startNextRollingCycle(
+    state: RollingCycleState,
+    startHighWaterMark: number,
+    now = Date.now(),
+): RollingCycleState {
+    const allHistory = [...state.history, state.active];
+    const nonCleaned = allHistory.filter(cycle => cycle.status !== 'cleaned');
+    const cleaned = allHistory.filter(cycle => cycle.status === 'cleaned');
+    const cleanedBudget = Math.max(0, 20 - nonCleaned.length);
+    const retainedCleaned = cleanedBudget > 0 ? cleaned.slice(-cleanedBudget) : [];
+    const history = [...retainedCleaned, ...nonCleaned]
+        .sort((left, right) => left.startedAt - right.startedAt);
+    const active = createRollingCycle(state.charId, startHighWaterMark, now);
+    const usedIds = new Set(allHistory.map(cycle => cycle.id));
+    const baseId = active.id;
+    let suffix = 2;
+    while (usedIds.has(active.id)) {
+        active.id = `${baseId}_${suffix++}`;
+    }
+    const next: RollingCycleState = {
+        ...state,
+        active,
+        history,
+    };
+    writeRollingCycleState(next);
+    return next;
+}
+
+export function getRecallableCycleIds(state: RollingCycleState | null): Set<string> {
+    if (!state) return new Set();
+    return new Set([
+        state.active.id,
+        ...state.history
+            .filter(cycle => cycle.status !== 'cleaned')
+            .map(cycle => cycle.id),
+    ]);
+}
+
+export function isRecallableLocalCycleNode(
+    node: MemoryNode,
+    state: RollingCycleState | null,
+): boolean {
+    if (!isLocalCycleNode(node)) return false;
+    return !state || getRecallableCycleIds(state).has(node.localCycleId!);
+}
+
+/**
+ * Re-home a delayed local write after an archive operation closed its cycle.
+ * Returns true when the node was changed.
+ */
+export function ensureNodeInActiveRollingCycle(node: MemoryNode): boolean {
+    if (!isRollingCycleEnabled() || node.origin === 'ombre') return false;
+    const state = ensureRollingCycleState(node.charId, 0);
+    if (node.localCycleId === state.active.id && state.active.status === 'collecting') {
+        return false;
+    }
+    node.localCycleId = state.active.id;
+    node.archivedToOmbreAt = null;
+    return true;
+}
+
+export function attachNodesToRollingCycle(
+    nodes: MemoryNode[],
+    cycleId: string,
+): MemoryNode[] {
+    for (const node of nodes) {
+        if (node.origin === 'ombre') continue;
+        node.localCycleId = cycleId;
+        node.archivedToOmbreAt = null;
+    }
+    return nodes;
+}
+
+export function isLocalCycleNode(node: MemoryNode, cycleId?: string): boolean {
+    if (!node.localCycleId || node.origin === 'ombre') return false;
+    return cycleId ? node.localCycleId === cycleId : true;
+}
+
+export function assessRollingCycle(
+    nodes: MemoryNode[],
+    cycle: RollingCycleRecord,
+    now = Date.now(),
+    nodeLimit = ROLLING_CYCLE_NODE_LIMIT,
+    maxAgeMs = ROLLING_CYCLE_MAX_AGE_MS,
+): RollingCycleTrigger {
+    const nodeCount = nodes.filter(node =>
+        isLocalCycleNode(node, cycle.id)
+        && !node.archived
+        && !node.archivedToOmbreAt
+    ).length;
+    const ageMs = Math.max(0, now - cycle.startedAt);
+    return {
+        due: nodeCount >= nodeLimit || ageMs >= maxAgeMs,
+        reason: nodeCount >= nodeLimit ? 'node_limit' : ageMs >= maxAgeMs ? 'age_limit' : null,
+        nodeCount,
+        ageMs,
+        nodeLimit,
+        maxAgeMs,
+    };
+}
+
+export function exportRollingCycleStates(): Record<string, string> | undefined {
+    const source = storage();
+    if (!source) return undefined;
+    const result: Record<string, string> = {};
+    for (let i = 0; i < source.length; i++) {
+        const key = source.key(i);
+        if (key?.startsWith('mp_cycle_state_')) {
+            result[key] = source.getItem(key) || '';
+        }
+    }
+    const enabled = source.getItem(ENABLED_KEY);
+    if (enabled !== null) result[ENABLED_KEY] = enabled;
+    return Object.keys(result).length > 0 ? result : undefined;
+}
+
+export function restoreRollingCycleStates(values?: Record<string, string>): void {
+    const target = storage();
+    if (!target || !values) return;
+    for (const [key, value] of Object.entries(values)) {
+        if (
+            typeof value === 'string'
+            && (key.startsWith('mp_cycle_state_') || key === ENABLED_KEY)
+        ) {
+            target.setItem(key, value);
+        }
+    }
+}
