+import { describe, expect, it } from 'vitest';
+import type { MemoryNode } from './types';
+import { SELF_NARRATIVE_ACCEPTED_TAG, SELF_NARRATIVE_CANDIDATE_TAG, SELF_NARRATIVE_MISJUDGED_TAG, SELF_NARRATIVE_OBSERVING_TAG, SELF_NARRATIVE_TAG, acceptSelfNarrative, createSelfNarrativeCandidate, isSelfNarrativeAccepted, isSelfNarrativeCandidate, isSelfNarrativeMisjudged, markSelfNarrativeMisjudged, observeSelfNarrative, reviseSelfNarrative } from './selfNarrative';
+const source: MemoryNode = { id: 'source-1', charId: 'yanke', content: 'source', room: 'self_room', tags: ['choice'], importance: 8, mood: 'reflective', embedded: true, createdAt: 1, lastAccessedAt: 1, accessCount: 0 };
+describe('self narrative candidate isolation', () => {
+    it('creates an archived, non-embedded self-room candidate', () => { const candidate = createSelfNarrativeCandidate('yanke', source, 'I listen first.', 100); expect(candidate).toMatchObject({ room: 'self_room', archived: true, embedded: false, sourceId: source.id }); expect(candidate.tags).toEqual(expect.arrayContaining([SELF_NARRATIVE_TAG, SELF_NARRATIVE_CANDIDATE_TAG])); expect(isSelfNarrativeCandidate(candidate)).toBe(true); });
+    it('accepts, observes, revises, and misjudges without breaking isolation', () => { const candidate = createSelfNarrativeCandidate('yanke', source, 'I listen first.', 100); const accepted = acceptSelfNarrative(candidate); expect(isSelfNarrativeAccepted(accepted)).toBe(true); expect(accepted).toMatchObject({ archived: true, embedded: false }); const observing = observeSelfNarrative(candidate); expect(observing.tags).toEqual(expect.arrayContaining([SELF_NARRATIVE_CANDIDATE_TAG, SELF_NARRATIVE_OBSERVING_TAG])); const revised = reviseSelfNarrative(candidate, ' revised '); expect(revised.content).toBe('revised'); expect(revised).toMatchObject({ archived: true, embedded: false }); const misjudged = markSelfNarrativeMisjudged(accepted); expect(misjudged.tags).toContain(SELF_NARRATIVE_MISJUDGED_TAG); expect(isSelfNarrativeMisjudged(misjudged)).toBe(true); expect(isSelfNarrativeAccepted(misjudged)).toBe(false); });
+});
