+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode, RemoteVectorConfig } from './types';
+
+const mocks = vi.hoisted(() => ({
+    vectorSearch: vi.fn(),
+}));
+
+vi.mock('./vectorSearch', () => ({ vectorSearch: mocks.vectorSearch }));
+vi.mock('./embedding', () => ({ getEmbedding: vi.fn() }));
+vi.mock('./db', () => ({
+    MemoryNodeDB: { getByCharId: vi.fn() },
+}));
+
+import { ensureRollingCycleState } from './rollingCycle';
+import { hybridSearch } from './hybridSearch';
+
+const node = (id: string, localCycleId: string): MemoryNode => ({
+    id,
+    charId: 'yanke',
+    content: 'only vector match',
+    room: 'study',
+    tags: [],
+    importance: 5,
+    mood: 'neutral',
+    embedded: true,
+    createdAt: Date.now(),
+    lastAccessedAt: Date.now(),
+    accessCount: 0,
+    origin: 'extraction',
+    localCycleId,
+});
+
+describe('hybrid search during a rolling cycle', () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+        vi.stubEnv('VITE_MEMORY_ROLLING_CYCLES', '1');
+        localStorage.clear();
+    });
+
+    it('uses local vectors and never forwards the remote config', async () => {
+        const state = ensureRollingCycleState('yanke', 0, 1_000);
+        const local = node('local-vector-only', state.active.id);
+        mocks.vectorSearch.mockResolvedValue([{ node: local, similarity: 0.95 }]);
+        const remote = {
+            enabled: true,
+            initialized: true,
+            provider: 'ombre',
+        } as RemoteVectorConfig;
+
+        const result = await hybridSearch(
+            'unrelated lexical query',
+            'yanke',
+            { baseUrl: 'https://embedding.invalid', apiKey: 'x', model: 'm', dimensions: 3 },
+            10,
+            remote,
+            {
+                queryVector: new Float32Array([1, 0, 0]),
+                allNodes: [local],
+                allVectors: [],
+            },
+        );
+
+        expect(mocks.vectorSearch).toHaveBeenCalledTimes(1);
+        expect(mocks.vectorSearch.mock.calls[0][4]).toBeUndefined();
+        expect(result.map(item => item.node.id)).toContain(local.id);
+    });
+
+    it('still forbids remote search when rolling is enabled before state exists', async () => {
+        const local = node('orphan-local', 'legacy-cycle');
+        mocks.vectorSearch.mockResolvedValue([{ node: local, similarity: 0.9 }]);
+        const remote = {
+            enabled: true,
+            initialized: true,
+            provider: 'ombre',
+        } as RemoteVectorConfig;
+
+        const result = await hybridSearch(
+            'query',
+            'yanke',
+            { baseUrl: 'https://embedding.invalid', apiKey: 'x', model: 'm', dimensions: 3 },
+            10,
+            remote,
+            {
+                queryVector: new Float32Array([1, 0, 0]),
+                allNodes: [local],
+                allVectors: [],
+            },
+        );
+
+        expect(mocks.vectorSearch.mock.calls[0][4]).toBeUndefined();
+        expect(result.map(item => item.node.id)).toContain(local.id);
+    });
+});
