+/** Provider-neutral remote memory facade. */
+import type { RemoteVectorConfig } from './types';
+import * as supabase from './supabaseVector';
+import * as ombre from './ombreMemory';
+export { INIT_SQL } from './supabaseVector';
+function provider(config: RemoteVectorConfig) { return config.provider === 'ombre' ? ombre : supabase; }
+export const testConnection = (config: RemoteVectorConfig) => provider(config).testConnection(config);
+export const upsertVector = (...args: Parameters<typeof supabase.upsertVector>) => provider(args[0]).upsertVector(...args);
+export const upsertVectorBatch = (...args: Parameters<typeof supabase.upsertVectorBatch>) => provider(args[0]).upsertVectorBatch(...args);
+export const fetchRemoteByRoom = (...args: Parameters<typeof supabase.fetchRemoteByRoom>) => provider(args[0]).fetchRemoteByRoom(...args);
+export const fetchRemotePage = (config: RemoteVectorConfig, charId: string, offset = 0, limit = 100, room?: string) => { if (config.provider !== 'ombre') throw new Error('Paged authoritative sync requires Ombre'); return ombre.fetchRemotePage(config, charId, offset, limit, room); };
+export const bulkSetArchived = (...args: Parameters<typeof supabase.bulkSetArchived>) => provider(args[0]).bulkSetArchived(...args);
+export const bulkSetRoom = (...args: Parameters<typeof supabase.bulkSetRoom>) => provider(args[0]).bulkSetRoom(...args);
+export const deleteVector = (...args: Parameters<typeof supabase.deleteVector>) => provider(args[0]).deleteVector(...args);
+export const getVectorCount = (...args: Parameters<typeof supabase.getVectorCount>) => provider(args[0]).getVectorCount(...args);
+export const syncLocalToRemote = (...args: Parameters<typeof supabase.syncLocalToRemote>) => provider(args[0]).syncLocalToRemote(...args);
+export function searchVectors(config: RemoteVectorConfig, queryVector: number[] | Float32Array | Uint8Array, charId: string, threshold = 0.3, topK = 20, queryText?: string) { return config.provider === 'ombre' ? ombre.searchVectors(config, queryVector, charId, threshold, topK, queryText) : supabase.searchVectors(config, queryVector, charId, threshold, topK); }
