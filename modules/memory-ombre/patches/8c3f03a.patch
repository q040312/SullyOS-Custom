@@ -0,0 +1,16 @@
+import type { RemoteVectorConfig } from './types';
+import { SULLY_MEMORY_URL } from '../deploymentUrls';
+
+export const OMBRE_AUTHORITATIVE_BUILD = import.meta.env.VITE_OMBRE_AUTHORITATIVE === '1';
+
+export function resolveAuthoritativeConfig(config?: RemoteVectorConfig | null): RemoteVectorConfig | null {
+    if (config?.enabled && config.initialized && config.provider === 'ombre') return config;
+    if (!OMBRE_AUTHORITATIVE_BUILD) return config || null;
+    return { enabled: true, provider: 'ombre', supabaseUrl: '', supabaseAnonKey: '', ombreUrl: SULLY_MEMORY_URL, ombreToken: '', initialized: true };
+}
+
+export function isOmbreAuthoritative(config?: RemoteVectorConfig | null): boolean {
+    if (!OMBRE_AUTHORITATIVE_BUILD) return false;
+    const resolved = resolveAuthoritativeConfig(config);
+    return !!(resolved?.enabled && resolved.initialized && resolved.provider === 'ombre');
+}
