+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode } from './types';
+import { MemoryNodeDB } from './db';
+import {
+    ensureRollingCycleState,
+    startNextRollingCycle,
+} from './rollingCycle';
+
+const makeNode = (id: string, charId: string, cycleId?: string): MemoryNode => ({
+    id,
+    charId,
+    content: 'delayed extraction',
+    room: 'study',
+    tags: [],
+    importance: 5,
+    mood: 'neutral',
+    embedded: false,
+    createdAt: 1,
+    lastAccessedAt: 1,
+    accessCount: 0,
+    origin: 'extraction',
+    localCycleId: cycleId,
+});
+
+describe('rolling-cycle delayed writes', () => {
+    beforeEach(() => {
+        vi.stubEnv('VITE_MEMORY_ROLLING_CYCLES', '1');
+        localStorage.clear();
+    });
+
+    it('re-homes a node whose extraction finished after its cycle closed', async () => {
+        const charId = `race-${Date.now()}`;
+        const first = ensureRollingCycleState(charId, 10, 1_000);
+        const second = startNextRollingCycle(first, 20, 2_000);
+        const delayed = makeNode(`node-${Date.now()}`, charId, first.active.id);
+
+        await MemoryNodeDB.save(delayed);
+        const saved = await MemoryNodeDB.getById(delayed.id);
+
+        expect(saved?.localCycleId).toBe(second.active.id);
+        expect(saved?.archivedToOmbreAt).toBeNull();
+        await MemoryNodeDB.deleteLocal(delayed.id);
+    });
+
+    it('creates a collecting cycle before saving when state is absent', async () => {
+        const charId = `absent-${Date.now()}`;
+        const fresh = makeNode(`node-${Date.now()}-fresh`, charId);
+
+        await MemoryNodeDB.save(fresh);
+        const saved = await MemoryNodeDB.getById(fresh.id);
+
+        expect(saved?.localCycleId).toMatch(/^cycle_/);
+        await MemoryNodeDB.deleteLocal(fresh.id);
+    });
+});
