@@ -0,0 +1,220 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode, RemoteVectorConfig } from './types';
+
+const mocks = vi.hoisted(() => ({
+    nodes: [] as MemoryNode[],
+    fetchRemotePage: vi.fn(),
+    upsertVectorBatch: vi.fn(),
+    searchVectors: vi.fn(),
+    getNodes: vi.fn(),
+    deleteVector: vi.fn(),
+    deleteNode: vi.fn(),
+}));
+
+vi.mock('./db', () => ({
+    MemoryNodeDB: {
+        getByCharId: mocks.getNodes,
+        saveManyLocal: vi.fn(async (updates: MemoryNode[]) => {
+            const byId = new Map(updates.map(node => [node.id, node]));
+            mocks.nodes = mocks.nodes.map(node => byId.get(node.id) || node);
+        }),
+        deleteLocal: mocks.deleteNode.mockImplementation(async (id: string) => {
+            mocks.nodes = mocks.nodes.filter(node => node.id !== id);
+        }),
+    },
+    EventBoxDB: {
+        getByCharId: vi.fn(async () => []),
+        delete: vi.fn(),
+        save: vi.fn(),
+    },
+    MemoryVectorDB: { delete: mocks.deleteVector },
+    MemoryLinkDB: { getByNodeId: vi.fn(async () => []), delete: vi.fn() },
+}));
+vi.mock('./ombreMemory', () => ({
+    fetchRemotePage: mocks.fetchRemotePage,
+    upsertVectorBatch: mocks.upsertVectorBatch,
+    searchVectors: mocks.searchVectors,
+}));
+
+import {
+    cleanupCommittedRollingCycle,
+    commitRollingCycleToOmbre,
+} from './rollingCycleArchive';
+import {
+    ensureRollingCycleState,
+    readRollingCycleState,
+} from './rollingCycle';
+
+const remote = {
+    enabled: true,
+    initialized: true,
+    provider: 'ombre',
+} as RemoteVectorConfig;
+const makeNode = (id: string, cycleId: string): MemoryNode => ({
+    id,
+    charId: 'yanke',
+    content: id,
+    room: 'study',
+    tags: [],
+    importance: 5,
+    mood: 'neutral',
+    embedded: true,
+    createdAt: 1,
+    lastAccessedAt: 1,
+    accessCount: 0,
+    origin: 'extraction',
+    localCycleId: cycleId,
+    archivedToOmbreAt: null,
+});
+
+describe('rolling cycle commit isolation', () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+        localStorage.clear();
+        mocks.nodes = [];
+        mocks.getNodes.mockImplementation(async () => mocks.nodes);
+        mocks.upsertVectorBatch.mockResolvedValue(true);
+        mocks.searchVectors.mockImplementation(async (
+            _config: RemoteVectorConfig,
+            _vector: Float32Array,
+            _charId: string,
+            _threshold: number,
+            _topK: number,
+            query: string,
+        ) => [{ memoryId: query }]);
+    });
+
+    it('freezes the committed snapshot and preserves concurrent new-cycle nodes', async () => {
+        const first = ensureRollingCycleState('yanke', 10, 1_000);
+        const original = makeNode('original', first.active.id);
+        mocks.nodes = [original];
+        let fetchCount = 0;
+        let inserted = false;
+        mocks.getNodes.mockImplementation(async () => {
+            if (!inserted) {
+                inserted = true;
+                const active = readRollingCycleState('yanke')!.active;
+                expect(active.id).not.toBe(first.active.id);
+                expect(active.startedAt).toBeLessThanOrEqual(Date.now());
+                expect(active.startHighWaterMark).toBe(0);
+                mocks.nodes.push(makeNode('concurrent', active.id));
+            }
+            return mocks.nodes;
+        });
+        mocks.fetchRemotePage.mockImplementation(async () => {
+            fetchCount++;
+            if (fetchCount === 1) {
+                return { memories: [], total: 0, offset: 0, limit: 100 };
+            }
+            return { memories: [original], total: 1, offset: 0, limit: 100 };
+        });
+
+        const result = await commitRollingCycleToOmbre(remote, 'yanke');
+        const afterCommit = readRollingCycleState('yanke')!;
+        const committed = afterCommit.history.find(cycle => cycle.id === result.cycleId)!;
+        expect(committed.status).toBe('committed');
+        expect(committed.committedNodeIds).toEqual(['original']);
+        expect(afterCommit.active.status).toBe('collecting');
+
+        const cleanup = await cleanupCommittedRollingCycle('yanke', 123);
+        expect(cleanup.nextCycleId).toBe(afterCommit.active.id);
+        expect(mocks.nodes.map(node => node.id)).toEqual(['concurrent']);
+        expect(mocks.deleteNode).toHaveBeenCalledWith('original');
+        expect(mocks.deleteNode).not.toHaveBeenCalledWith('concurrent');
+    });
+
+    it('keeps a failed snapshot recallable and supports an explicit retry', async () => {
+        const first = ensureRollingCycleState('yanke', 10, 1_000);
+        mocks.nodes = [makeNode('original', first.active.id)];
+        mocks.fetchRemotePage.mockResolvedValue({ memories: [], total: 0, offset: 0, limit: 100 });
+        mocks.upsertVectorBatch.mockResolvedValue(false);
+
+        await expect(commitRollingCycleToOmbre(remote, 'yanke')).rejects.toThrow(/upload failed/);
+        const state = readRollingCycleState('yanke')!;
+        expect(state.active.status).toBe('collecting');
+        expect(state.active.id).not.toBe(first.active.id);
+        expect(state.history.find(cycle => cycle.id === first.active.id)?.status).toBe('failed');
+        expect(mocks.nodes.map(node => node.id)).toEqual(['original']);
+
+        let fetchCount = 0;
+        mocks.upsertVectorBatch.mockResolvedValue(true);
+        mocks.fetchRemotePage.mockImplementation(async () => {
+            fetchCount++;
+            return fetchCount === 1
+                ? { memories: [], total: 0, offset: 0, limit: 100 }
+                : { memories: mocks.nodes, total: mocks.nodes.length, offset: 0, limit: 100 };
+        });
+        const retried = await commitRollingCycleToOmbre(
+            remote,
+            'yanke',
+            undefined,
+            first.active.id,
+        );
+        expect(retried.cycleId).toBe(first.active.id);
+        expect(readRollingCycleState('yanke')!.history
+            .find(cycle => cycle.id === first.active.id)?.status).toBe('committed');
+    });
+
+    it('commits and cleans an empty cycle without remote calls', async () => {
+        const first = ensureRollingCycleState('yanke', 10, 1_000);
+        const result = await commitRollingCycleToOmbre(remote, 'yanke');
+        expect(result).toMatchObject({ cycleId: first.active.id, sourceCount: 0, uploadedCount: 0 });
+        expect(mocks.fetchRemotePage).not.toHaveBeenCalled();
+
+        const cleanup = await cleanupCommittedRollingCycle('yanke', result.cycleId);
+        expect(cleanup.deletedNodes).toBe(0);
+        expect(readRollingCycleState('yanke')!.history
+            .find(cycle => cycle.id === result.cycleId)?.status).toBe('cleaned');
+    });
+
+    it('refuses cleanup for a legacy committed record without a snapshot ledger', async () => {
+        const first = ensureRollingCycleState('yanke', 10, 1_000);
+        first.active.status = 'committed';
+        first.active.committedAt = 2_000;
+        const raw = JSON.parse(JSON.stringify(first));
+        delete raw.active.committedNodeIds;
+        delete raw.active.cleanupSnapshotRecorded;
+        localStorage.setItem('mp_cycle_state_yanke', JSON.stringify(raw));
+
+        await expect(cleanupCommittedRollingCycle('yanke', first.active.id))
+            .rejects.toThrow(/no verified cleanup snapshot/);
+        expect(mocks.deleteNode).not.toHaveBeenCalled();
+    });
+
+    it('serializes commit and cleanup operations without losing newer ledger state', async () => {
+        const first = ensureRollingCycleState('yanke', 10, 1_000);
+        const original = makeNode('original', first.active.id);
+        mocks.nodes = [original];
+        mocks.fetchRemotePage.mockImplementation(async () => ({
+            memories: mocks.nodes,
+            total: mocks.nodes.length,
+            offset: 0,
+            limit: 100,
+        }));
+
+        const firstCommit = commitRollingCycleToOmbre(remote, 'yanke');
+        const secondCommit = commitRollingCycleToOmbre(remote, 'yanke');
+        const [firstResult, secondResult] = await Promise.all([firstCommit, secondCommit]);
+
+        let state = readRollingCycleState('yanke')!;
+        expect(state.history.find(cycle => cycle.id === firstResult.cycleId)?.status)
+            .toBe('committed');
+        expect(state.history.find(cycle => cycle.id === secondResult.cycleId)?.status)
+            .toBe('committed');
+        const thirdCycleId = state.active.id;
+
+        const cleanup = cleanupCommittedRollingCycle('yanke', firstResult.cycleId);
+        const thirdCommit = commitRollingCycleToOmbre(remote, 'yanke');
+        const [, thirdResult] = await Promise.all([cleanup, thirdCommit]);
+
+        state = readRollingCycleState('yanke')!;
+        expect(state.history.find(cycle => cycle.id === firstResult.cycleId)?.status)
+            .toBe('cleaned');
+        expect(state.history.find(cycle => cycle.id === secondResult.cycleId)?.status)
+            .toBe('committed');
+        expect(thirdResult.cycleId).toBe(thirdCycleId);
+        expect(state.history.find(cycle => cycle.id === thirdCycleId)?.status)
+            .toBe('committed');
+        expect(state.active.id).not.toBe(thirdCycleId);
+    });
+});
