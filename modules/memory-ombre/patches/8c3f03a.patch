diff --git a/utils/memoryPalace/deleteMemory.ts b/utils/memoryPalace/deleteMemory.ts
new file mode 100644
index 0000000..fb8553e
--- /dev/null
+++ b/utils/memoryPalace/deleteMemory.ts
@@ -0,0 +1,43 @@
+import type { RemoteVectorConfig } from './types';
+import { MemoryLinkDB, MemoryNodeDB, MemoryVectorDB } from './db';
+import { removeMemoryFromBox } from './eventBox';
+import { isOmbreAuthoritative } from './authority';
+import { deleteVector } from './remoteVector';
+
+/**
+ * Delete one memory and all rebuildable local references.
+ *
+ * In authoritative mode the remote delete is the commit point: no local state
+ * is touched unless Ombre confirms it first. EventBox cleanup is explicitly
+ * local-only so it cannot re-upsert the node that Ombre just deleted.
+ */
+export async function deleteMemoryCompletely(
+    nodeId: string,
+    remoteVectorConfig?: RemoteVectorConfig | null,
+): Promise<void> {
+    const authoritative = isOmbreAuthoritative(remoteVectorConfig);
+    if (authoritative) {
+        await MemoryNodeDB.confirmAuthoritativeDelete(nodeId);
+    }
+
+    // The node is about to be deleted. Syncing this transient unbound state
+    // would race the remote DELETE and could resurrect the record.
+    await removeMemoryFromBox(nodeId, true);
+
+    const links = await MemoryLinkDB.getByNodeId(nodeId);
+    for (const link of links) {
+        await MemoryLinkDB.delete(link.id);
+    }
+    await MemoryVectorDB.delete(nodeId);
+
+    if (
+        remoteVectorConfig?.enabled
+        && remoteVectorConfig.initialized
+        && remoteVectorConfig.provider !== 'ombre'
+    ) {
+        void deleteVector(remoteVectorConfig, nodeId).catch(() => {});
+    }
+
+    if (authoritative) await MemoryNodeDB.deleteLocal(nodeId);
+    else await MemoryNodeDB.delete(nodeId);
+}
