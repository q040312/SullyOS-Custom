+import { describe, expect, it } from 'vitest';
+import type { EventBox, MemoryNode } from './types';
+import { selectRollingCycleCandidates } from './rollingCycleArchive';
+
+const node = (id: string, content: string, extra: Partial<MemoryNode> = {}): MemoryNode => ({
+    id,
+    charId: 'yanke',
+    content,
+    room: 'living_room',
+    tags: [],
+    importance: 5,
+    mood: 'neutral',
+    embedded: true,
+    createdAt: Number(id.replace(/\D/g, '')) || 1,
+    lastAccessedAt: 1,
+    accessCount: 0,
+    origin: 'extraction',
+    localCycleId: 'cycle-1',
+    ...extra,
+});
+
+describe('selectRollingCycleCandidates', () => {
+    it('never includes Ombre mirrors or nodes from another cycle', () => {
+        const result = selectRollingCycleCandidates([
+            node('n1', 'keep'),
+            node('n2', 'remote', { origin: 'ombre', localCycleId: null }),
+            node('n3', 'other', { localCycleId: 'cycle-2' }),
+        ], [], 'cycle-1');
+        expect(result.candidates.map(item => item.id)).toEqual(['n1']);
+    });
+
+    it('uses an EventBox summary in place of its members', () => {
+        const summary = node('n3', 'summary', { isBoxSummary: true });
+        const box: EventBox = {
+            id: 'b1',
+            charId: 'yanke',
+            name: 'box',
+            tags: [],
+            summaryNodeId: summary.id,
+            liveMemoryIds: ['n1'],
+            archivedMemoryIds: ['n2'],
+            compressionCount: 1,
+            createdAt: 1,
+            updatedAt: 1,
+            lastCompressedAt: 1,
+        };
+        const result = selectRollingCycleCandidates([
+            node('n1', 'live'),
+            node('n2', 'archived', { archived: true }),
+            summary,
+        ], [box], 'cycle-1');
+        expect(result.candidates.map(item => item.id)).toEqual(['n3']);
+    });
+
+    it('collapses exact normalized duplicates and keeps the stronger item', () => {
+        const result = selectRollingCycleCandidates([
+            node('n1', '小云，喜欢 雨。', { importance: 4 }),
+            node('n2', '小云喜欢雨', { importance: 8 }),
+        ], [], 'cycle-1');
+        expect(result.candidates).toHaveLength(1);
+        expect(result.candidates[0].id).toBe('n2');
+        expect(result.exactDuplicatesRemoved).toBe(1);
+    });
+});
diff --git a/utils/memoryPalace/rollingCycleArchive.ts b/utils/memoryPalace/rollingCycleArchive.ts
new file mode 100644
index 0000000..30cd0dc
--- /dev/null
+++ b/utils/memoryPalace/rollingCycleArchive.ts
@@ -0,0 +1,509 @@
+import type { EventBox, MemoryNode, RemoteVectorConfig } from './types';
+import {
+    EventBoxDB,
+    MemoryLinkDB,
+    MemoryNodeDB,
+    MemoryVectorDB,
+} from './db';
+import {
+    assessRollingCycle,
+    ensureRollingCycleState,
+    isLocalCycleNode,
+    readRollingCycleState,
+    startNextRollingCycle,
+    withRollingCycleLock,
+    writeRollingCycleState,
+    type RollingCycleRecord,
+    type RollingCycleState,
+    type RollingCycleTrigger,
+} from './rollingCycle';
+import {
+    fetchRemotePage,
+    searchVectors,
+    upsertVectorBatch,
+} from './ombreMemory';
+import { getLocalMemoryPalaceHighWaterMark } from './highWaterMark';
+
+const UPLOAD_BATCH_SIZE = 50;
+const VERIFY_PAGE_SIZE = 100;
+const SEMANTIC_SAMPLE_COUNT = 3;
+const VERIFY_ATTEMPTS = 4;
+const VERIFY_DELAY_MS = 1_500;
+
+export interface RollingCyclePreview {
+    state: RollingCycleState;
+    trigger: RollingCycleTrigger;
+    sourceCount: number;
+    sourceNodeIds: string[];
+    candidates: MemoryNode[];
+    exactDuplicatesRemoved: number;
+}
+
+export interface RollingCycleCommitResult {
+    cycleId: string;
+    sourceCount: number;
+    uploadedCount: number;
+    alreadyRemoteCount: number;
+    exactDuplicatesRemoved: number;
+    remoteBucketIds: string[];
+}
+
+export interface RollingCycleCleanupResult {
+    cycleId: string;
+    deletedNodes: number;
+    deletedVectors: number;
+    deletedLinks: number;
+    deletedEventBoxes: number;
+    updatedEventBoxes: number;
+    nextCycleId: string;
+}
+
+function normalizedContent(value: string): string {
+    return (value || '')
+        .normalize('NFKC')
+        .replace(/[\s\p{P}]+/gu, '')
+        .trim()
+        .toLowerCase();
+}
+
+function preferCandidate(left: MemoryNode, right: MemoryNode): MemoryNode {
+    if (!!left.isBoxSummary !== !!right.isBoxSummary) {
+        return left.isBoxSummary ? left : right;
+    }
+    if (left.importance !== right.importance) {
+        return left.importance > right.importance ? left : right;
+    }
+    return left.createdAt >= right.createdAt ? left : right;
+}
+
+/**
+ * Produce a loss-resistant archive set:
+ * - a current-cycle EventBox summary replaces its current-cycle members;
+ * - orphaned/unsummarized members are retained;
+ * - exact normalized duplicates collapse to the strongest representative.
+ */
+export function selectRollingCycleCandidates(
+    nodes: MemoryNode[],
+    eventBoxes: EventBox[],
+    cycleId: string,
+): { sourceCount: number; sourceNodeIds: string[]; candidates: MemoryNode[]; exactDuplicatesRemoved: number } {
+    const source = nodes.filter(node =>
+        isLocalCycleNode(node, cycleId) && !node.archivedToOmbreAt
+    );
+    const byId = new Map(source.map(node => [node.id, node]));
+    const replacedIds = new Set<string>();
+
+    for (const box of eventBoxes) {
+        if (!box.summaryNodeId || !byId.has(box.summaryNodeId)) continue;
+        for (const id of [...box.liveMemoryIds, ...box.archivedMemoryIds]) {
+            if (id !== box.summaryNodeId && byId.has(id)) replacedIds.add(id);
+        }
+    }
+
+    const deduped = new Map<string, MemoryNode>();
+    for (const node of source) {
+        if (replacedIds.has(node.id)) continue;
+        const key = normalizedContent(node.content);
+        if (!key) continue;
+        const existing = deduped.get(key);
+        deduped.set(key, existing ? preferCandidate(existing, node) : node);
+    }
+
+    const candidates = [...deduped.values()]
+        .sort((a, b) => a.createdAt - b.createdAt || a.id.localeCompare(b.id));
+    return {
+        sourceCount: source.length,
+        sourceNodeIds: source.map(node => node.id),
+        candidates,
+        exactDuplicatesRemoved: source.length - replacedIds.size - candidates.length,
+    };
+}
+
+function replaceActive(
+    state: RollingCycleState,
+    patch: Partial<RollingCycleRecord>,
+): RollingCycleState {
+    const next = { ...state, active: { ...state.active, ...patch } };
+    writeRollingCycleState(next);
+    return next;
+}
+
+function replaceCycle(
+    state: RollingCycleState,
+    cycleId: string,
+    patch: Partial<RollingCycleRecord>,
+): RollingCycleState {
+    const latest = readRollingCycleState(state.charId) || state;
+    if (latest.active.id === cycleId) return replaceActive(latest, patch);
+    let found = false;
+    const history = latest.history.map(cycle => {
+        if (cycle.id !== cycleId) return cycle;
+        found = true;
+        return { ...cycle, ...patch };
+    });
+    if (!found) throw new Error(`Rolling cycle ${cycleId} does not exist`);
+    const next = { ...latest, history };
+    writeRollingCycleState(next);
+    return next;
+}
+
+function findCycle(
+    state: RollingCycleState,
+    cycleId: string,
+): RollingCycleRecord | undefined {
+    return state.active.id === cycleId
+        ? state.active
+        : state.history.find(cycle => cycle.id === cycleId);
+}
+
+async function fetchAllRemote(
+    config: RemoteVectorConfig,
+    charId: string,
+): Promise<MemoryNode[]> {
+    const result: MemoryNode[] = [];
+    let offset = 0;
+    let total = Number.POSITIVE_INFINITY;
+    while (offset < total) {
+        const page = await fetchRemotePage(config, charId, offset, VERIFY_PAGE_SIZE);
+        result.push(...(page.memories || []));
+        total = Number.isFinite(page.total) ? page.total : result.length;
+        if (!page.memories?.length || result.length >= total) break;
+        offset += page.memories.length;
+    }
+    return result;
+}
+
+export async function previewRollingCycle(
+    charId: string,
+    cycleId?: string,
+): Promise<RollingCyclePreview> {
+    const state = ensureRollingCycleState(charId, 0);
+    const targetId = cycleId || state.active.id;
+    const cycle = findCycle(state, targetId);
+    if (!cycle) throw new Error(`Rolling cycle ${targetId} does not exist`);
+    const [nodes, eventBoxes] = await Promise.all([
+        MemoryNodeDB.getByCharId(charId),
+        EventBoxDB.getByCharId(charId),
+    ]);
+    const selected = selectRollingCycleCandidates(nodes, eventBoxes, targetId);
+    return {
+        state,
+        trigger: assessRollingCycle(nodes, cycle),
+        ...selected,
+    };
+}
+
+async function verifySemanticSamples(
+    config: RemoteVectorConfig,
+    charId: string,
+    candidates: MemoryNode[],
+): Promise<boolean> {
+    if (!candidates.length) return true;
+    const step = Math.max(1, Math.floor(candidates.length / SEMANTIC_SAMPLE_COUNT));
+    const samples = candidates.filter((_, index) => index % step === 0)
+        .slice(0, SEMANTIC_SAMPLE_COUNT);
+
+    for (let attempt = 0; attempt < VERIFY_ATTEMPTS; attempt++) {
+        let passed = true;
+        for (const sample of samples) {
+            try {
+                const hits = await searchVectors(
+                    config,
+                    new Float32Array(0),
+                    charId,
+                    0,
+                    20,
+                    sample.content.slice(0, 240),
+                );
+                if (!hits.some(hit => hit.memoryId === sample.id)) {
+                    passed = false;
+                    break;
+                }
+            } catch {
+                passed = false;
+                break;
+            }
+        }
+        if (passed) return true;
+        if (attempt < VERIFY_ATTEMPTS - 1) {
+            await new Promise(resolve => setTimeout(resolve, VERIFY_DELAY_MS));
+        }
+    }
+    return false;
+}
+
+/**
+ * Upload and verify a cycle. This never deletes local data.
+ * Re-running it is safe because Ombre derives stable buckets from memoryId.
+ */
+async function commitRollingCycleToOmbreUnlocked(
+    config: RemoteVectorConfig,
+    charId: string,
+    onProgress?: (stage: string, done: number, total: number) => void,
+    retryCycleId?: string,
+): Promise<RollingCycleCommitResult> {
+    let state = ensureRollingCycleState(charId, getLocalMemoryPalaceHighWaterMark(charId));
+    const cycleId = retryCycleId || state.active.id;
+    const target = findCycle(state, cycleId);
+    if (!target) throw new Error(`Rolling cycle ${cycleId} does not exist`);
+    if (retryCycleId) {
+        if (state.active.id === cycleId || target.status !== 'failed') {
+            throw new Error('Only a failed history cycle can be retried');
+        }
+        state = replaceCycle(state, cycleId, {
+            status: 'preparing',
+            candidateCount: 0,
+            uploadedCount: 0,
+            committedAt: null,
+            cleanupSnapshotRecorded: false,
+            error: null,
+        });
+    } else {
+        if (target.status !== 'collecting') {
+            throw new Error('Active rolling cycle is not collecting');
+        }
+        // Close and switch synchronously before the first IndexedDB read.
+        state = replaceActive(state, {
+            status: 'preparing',
+            closedAt: target.closedAt || Date.now(),
+            candidateCount: 0,
+            error: null,
+        });
+        state = startNextRollingCycle(
+            state,
+            getLocalMemoryPalaceHighWaterMark(charId),
+            Date.now(),
+        );
+    }
+
+    try {
+        const preview = await previewRollingCycle(charId, cycleId);
+        state = replaceCycle(preview.state, cycleId, {
+            candidateCount: preview.candidates.length,
+        });
+        if (preview.sourceCount === 0) {
+            const committedAt = Date.now();
+            replaceCycle(state, cycleId, {
+                status: 'committed',
+                committedAt,
+                uploadedCount: 0,
+                remoteBucketIds: [],
+                committedNodeIds: [],
+                cleanupSnapshotRecorded: true,
+                error: null,
+            });
+            return {
+                cycleId,
+                sourceCount: 0,
+                uploadedCount: 0,
+                alreadyRemoteCount: 0,
+                exactDuplicatesRemoved: 0,
+                remoteBucketIds: [],
+            };
+        }
+        const remoteBefore = await fetchAllRemote(config, charId);
+        const remoteByContent = new Map(
+            remoteBefore
+                .map(node => [normalizedContent(node.content), node] as const)
+                .filter(([key]) => !!key),
+        );
+        const alreadyRemote = preview.candidates.filter(node =>
+            remoteByContent.has(normalizedContent(node.content))
+        );
+        const toUpload = preview.candidates.filter(node =>
+            !remoteByContent.has(normalizedContent(node.content))
+        );
+
+        state = replaceCycle(state, cycleId, { status: 'uploading' });
+        let uploaded = 0;
+        for (let index = 0; index < toUpload.length; index += UPLOAD_BATCH_SIZE) {
+            const batch = toUpload.slice(index, index + UPLOAD_BATCH_SIZE);
+            const ok = await upsertVectorBatch(config, batch.map(node => ({
+                memoryId: node.id,
+                charId,
+                vector: new Float32Array(0),
+                node,
+                dimensions: 0,
+            })));
+            if (!ok) throw new Error(`Ombre batch upload failed at ${index}`);
+            uploaded += batch.length;
+            onProgress?.('uploading', uploaded, toUpload.length);
+        }
+
+        state = replaceCycle(state, cycleId, { status: 'verifying', uploadedCount: uploaded });
+        const remoteAfter = await fetchAllRemote(config, charId);
+        const remoteIds = new Set(remoteAfter.map(node => node.id));
+        const missing = toUpload.filter(node => !remoteIds.has(node.id));
+        if (missing.length) {
+            throw new Error(`Ombre verification missing ${missing.length} memories`);
+        }
+        if (!await verifySemanticSamples(config, charId, toUpload)) {
+            throw new Error('Ombre semantic verification did not surface uploaded samples');
+        }
+
+        const committedAt = Date.now();
+        const localNodes = await MemoryNodeDB.getByCharId(charId);
+        const committedIds = new Set(preview.candidates.map(node => node.id));
+        const updated = localNodes
+            .filter(node => isLocalCycleNode(node, cycleId) && committedIds.has(node.id))
+            .map(node => ({ ...node, archivedToOmbreAt: committedAt }));
+        await MemoryNodeDB.saveManyLocal(updated);
+
+        const remoteBucketIds = [
+            ...toUpload.map(node => node.id),
+            ...alreadyRemote.map(node =>
+                remoteByContent.get(normalizedContent(node.content))?.id || node.id),
+        ];
+        replaceCycle(state, cycleId, {
+            status: 'committed',
+            committedAt,
+            uploadedCount: uploaded,
+            remoteBucketIds,
+            committedNodeIds: preview.sourceNodeIds,
+            cleanupSnapshotRecorded: true,
+            error: null,
+        });
+        return {
+            cycleId,
+            sourceCount: preview.sourceCount,
+            uploadedCount: uploaded,
+            alreadyRemoteCount: alreadyRemote.length,
+            exactDuplicatesRemoved: preview.exactDuplicatesRemoved,
+            remoteBucketIds,
+        };
+    } catch (error: any) {
+        const current = ensureRollingCycleState(charId, 0);
+        replaceCycle(current, cycleId, {
+            status: 'failed',
+            error: error?.message || String(error),
+        });
+        throw error;
+    }
+}
+
+export function commitRollingCycleToOmbre(
+    config: RemoteVectorConfig,
+    charId: string,
+    onProgress?: (stage: string, done: number, total: number) => void,
+    retryCycleId?: string,
+): Promise<RollingCycleCommitResult> {
+    return withRollingCycleLock(charId, () =>
+        commitRollingCycleToOmbreUnlocked(
+            config,
+            charId,
+            onProgress,
+            retryCycleId,
+        )
+    );
+}
+
+/**
+ * Delete only derived local memory artifacts after a verified commit.
+ * Chat messages, high-water marks, room plates and cycle ledger are preserved.
+ */
+async function cleanupCommittedRollingCycleUnlocked(
+    charId: string,
+    cycleIdOrHighWaterMark: string | number,
+): Promise<RollingCycleCleanupResult> {
+    const state = ensureRollingCycleState(charId, 0);
+    const cycleId = typeof cycleIdOrHighWaterMark === 'string'
+        ? cycleIdOrHighWaterMark
+        : [state.active, ...state.history]
+            .filter(cycle => cycle.status === 'committed' && !cycle.cleanedAt)
+            .sort((left, right) => (right.committedAt || 0) - (left.committedAt || 0))[0]?.id;
+    if (!cycleId) {
+        throw new Error('No committed rolling cycle is available for cleanup');
+    }
+    const committed = findCycle(state, cycleId);
+    if (
+        !committed
+        || committed.status !== 'committed'
+        || !committed.committedAt
+    ) {
+        throw new Error('Rolling cycle is not verified and committed; cleanup refused');
+    }
+    if (!committed.cleanupSnapshotRecorded) {
+        throw new Error('Rolling cycle has no verified cleanup snapshot; cleanup refused');
+    }
+    const [allNodes, boxes] = await Promise.all([
+        MemoryNodeDB.getByCharId(charId),
+        EventBoxDB.getByCharId(charId),
+    ]);
+    const committedIds = new Set(committed.committedNodeIds);
+    const nodes = allNodes.filter(node =>
+        isLocalCycleNode(node, cycleId) && committedIds.has(node.id)
+    );
+    const ids = new Set(nodes.map(node => node.id));
+    const stranded = allNodes.filter(node =>
+        isLocalCycleNode(node, cycleId) && !committedIds.has(node.id)
+    );
+    if (stranded.length > 0) {
+        const activeId = (readRollingCycleState(charId) || state).active.id;
+        await MemoryNodeDB.saveManyLocal(stranded.map(node => ({
+            ...node,
+            localCycleId: activeId,
+            archivedToOmbreAt: null,
+        })));
+    }
+
+    let deletedLinks = 0;
+    for (const node of nodes) {
+        const links = await MemoryLinkDB.getByNodeId(node.id);
+        for (const link of links) {
+            await MemoryLinkDB.delete(link.id);
+            deletedLinks++;
+        }
+        await MemoryVectorDB.delete(node.id);
+        await MemoryNodeDB.deleteLocal(node.id);
+    }
+
+    let deletedEventBoxes = 0;
+    let updatedEventBoxes = 0;
+    for (const box of boxes) {
+        const liveMemoryIds = box.liveMemoryIds.filter(id => !ids.has(id));
+        const archivedMemoryIds = box.archivedMemoryIds.filter(id => !ids.has(id));
+        const summaryNodeId = box.summaryNodeId && !ids.has(box.summaryNodeId)
+            ? box.summaryNodeId
+            : null;
+        const changed = liveMemoryIds.length !== box.liveMemoryIds.length
+            || archivedMemoryIds.length !== box.archivedMemoryIds.length
+            || summaryNodeId !== box.summaryNodeId;
+        if (!changed) continue;
+        if (!summaryNodeId && liveMemoryIds.length === 0 && archivedMemoryIds.length === 0) {
+            await EventBoxDB.delete(box.id);
+            deletedEventBoxes++;
+        } else {
+            await EventBoxDB.save({
+                ...box,
+                liveMemoryIds,
+                archivedMemoryIds,
+                summaryNodeId,
+                updatedAt: Date.now(),
+            });
+            updatedEventBoxes++;
+        }
+    }
+
+    const cleaned = replaceCycle(state, cycleId, {
+        status: 'cleaned',
+        cleanedAt: Date.now(),
+    });
+    return {
+        cycleId,
+        deletedNodes: nodes.length,
+        deletedVectors: nodes.length,
+        deletedLinks,
+        deletedEventBoxes,
+        updatedEventBoxes,
+        nextCycleId: cleaned.active.id,
+    };
+}
+
+export function cleanupCommittedRollingCycle(
+    charId: string,
+    cycleIdOrHighWaterMark: string | number,
+): Promise<RollingCycleCleanupResult> {
+    return withRollingCycleLock(charId, () =>
+        cleanupCommittedRollingCycleUnlocked(charId, cycleIdOrHighWaterMark)
+    );
+}
