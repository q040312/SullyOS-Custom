+import type { MemoryNode } from './types';
+import { isStableCognition, parseStableCognition } from './stableCognition';
+export const STABLE_COGNITION_CONTEXT_CONTENT_BUDGET = 700;
+export const STABLE_COGNITION_CONTEXT_MAX_ITEMS = 2;
+const HAN_RE = /[\p{Script=Han}]+/gu;
+const WORD_RE = /[a-z0-9][a-z0-9_-]+/giu;
+const STOP_TOKENS = new Set(['\u6211\u4eec', '\u4f60\u4eec', '\u4ed6\u4eec', '\u5979\u4eec', '\u81ea\u5df1', '\u8fd9\u4e2a', '\u90a3\u4e2a', '\u4e00\u79cd', '\u4e00\u4e2a', '\u4ec0\u4e48', '\u600e\u4e48', '\u4e3a\u4ec0\u4e48', '\u65f6\u5019', '\u73b0\u5728', '\u8fd8\u662f', '\u5c31\u662f', '\u53ef\u4ee5', '\u89c9\u5f97']);
+function collectTokens(text: string): Set<string> { const out = new Set<string>(); const normalized = text.toLowerCase(); for (const match of normalized.matchAll(WORD_RE)) if (match[0].length >= 2) out.add(match[0]); for (const match of normalized.matchAll(HAN_RE)) { const run = match[0]; if (run.length === 1) continue; if (run.length <= 4 && !STOP_TOKENS.has(run)) out.add(run); for (let i = 0; i < run.length - 1; i++) { const token = run.slice(i, i + 2); if (!STOP_TOKENS.has(token)) out.add(token); } } return out; }
+function relevanceScore(node: MemoryNode, queryTokens: Set<string>): number { if (!queryTokens.size) return 0; const data = parseStableCognition(node.content); if (!data) return 0; const nodeTokens = collectTokens([data.conclusion, data.conditions, data.counterexamples, data.scenes.join(' ')].join('\n')); let overlap = 0; for (const token of queryTokens) if (nodeTokens.has(token)) overlap += token.length >= 3 ? 2 : 1; return overlap ? overlap * 100 + Math.max(0, Math.min(10, node.importance || 0)) : 0; }
+export function selectStableCognitions(nodes: MemoryNode[], query: string, contentBudget = STABLE_COGNITION_CONTEXT_CONTENT_BUDGET, maxItems = STABLE_COGNITION_CONTEXT_MAX_ITEMS): MemoryNode[] { if (contentBudget <= 0 || maxItems <= 0) return []; const tokens = collectTokens(query); const ranked = nodes.filter(isStableCognition).map(node => ({ node, data: parseStableCognition(node.content), score: relevanceScore(node, tokens) })).filter(item => item.data && item.score > 0).sort((a, b) => b.score - a.score || b.node.importance - a.node.importance || b.node.createdAt - a.node.createdAt); const selected: MemoryNode[] = []; let used = 0; for (const item of ranked) { const data = item.data!; const length = data.conclusion.length + data.conditions.length + data.counterexamples.length; if (used + length > contentBudget) continue; selected.push(item.node); used += length; if (selected.length >= maxItems) break; } return selected; }
+export function formatStableCognitionContext(nodes: MemoryNode[]): string { const items = nodes.flatMap(node => { const data = parseStableCognition(node.content); return data ? [`- \u7a33\u5b9a\u8ba4\u77e5\uff1a${data.conclusion}\n  \u9002\u7528\u6761\u4ef6\uff1a${data.conditions}\n  \u53cd\u4f8b/\u8fb9\u754c\uff1a${data.counterexamples || '\u6682\u65e0'}`] : []; }); return items.length ? `\n\n### \u7a33\u5b9a\u81ea\u6211\u8ba4\u77e5\uff08\u4eba\u5de5\u6574\u5408\u3001\u53ef\u4fee\u8ba2\uff09\n\u4ee5\u4e0b\u5185\u5bb9\u7531\u591a\u65e5\u3001\u591a\u573a\u666f\u7684\u5df2\u91c7\u7eb3\u81ea\u8ff0\u4eba\u5de5\u6574\u5408\u800c\u6210\u3002\u53ea\u5728\u4e0e\u5f53\u524d\u8bdd\u9898\u76f4\u63a5\u76f8\u5173\u65f6\u53c2\u8003\uff0c\u6700\u591a\u4f7f\u7528\u4e00\u5230\u4e24\u6761\uff1b\u4e0d\u8981\u673a\u68b0\u590d\u8ff0\uff0c\u4e0d\u8981\u5f3a\u884c\u5e26\u5165\u65e0\u5173\u56de\u7b54\uff0c\u4e5f\u4e0d\u8981\u628a\u5b83\u89c6\u4e3a\u4e0d\u53ef\u4fee\u8ba2\u7684\u4eba\u683c\u5b9a\u4e49\u3002\n${items.join('\n')}` : ''; }
