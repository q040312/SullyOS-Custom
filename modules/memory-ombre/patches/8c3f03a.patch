index 0000000..76c7983
--- /dev/null
+++ b/utils/memoryPalace/authoritativeCache.ts
@@ -0,0 +1,106 @@
+import type { MemoryNode, RemoteVectorConfig } from './types';
+import { isOmbreAuthoritative } from './authority';
+import { MemoryNodeDB } from './db';
+import { fetchRemotePage } from './remoteVector';
+import { isRollingCycleEnabled } from './rollingCycle';
+import { isSelfNarrativeRecord } from './selfNarrative';
+
+const lastRefresh = new Map<string, number>();
+const inFlight = new Map<string, Promise<MemoryNode[]>>();
+const selfNarrativeLastRefresh = new Map<string, number>();
+const selfNarrativeInFlight = new Map<string, Promise<MemoryNode[]>>();
+const REFRESH_INTERVAL_MS = 30_000;
+
+/**
+ * Rolling-cycle mode deliberately keeps Ombre as an archive instead of
+ * mirroring it into IndexedDB. Self-narrative candidates are the exception:
+ * they are management-only records and must remain visible across devices,
+ * while their archived flag still keeps them out of recall and embedding.
+ */
+export async function refreshSelfNarrativeCandidateCache(
+    charId: string,
+    config?: RemoteVectorConfig,
+    force = false,
+): Promise<MemoryNode[]> {
+    if (!isOmbreAuthoritative(config)) {
+        return (await MemoryNodeDB.getByCharId(charId)).filter(isSelfNarrativeRecord);
+    }
+
+    const now = Date.now();
+    if (!force && now - (selfNarrativeLastRefresh.get(charId) || 0) < REFRESH_INTERVAL_MS) {
+        return (await MemoryNodeDB.getByCharId(charId)).filter(isSelfNarrativeRecord);
+    }
+    const running = selfNarrativeInFlight.get(charId);
+    if (running) return running;
+
+    const task = (async () => {
+        const remoteRoom: MemoryNode[] = [];
+        const pageSize = 100;
+        let offset = 0;
+        let total = Number.POSITIVE_INFINITY;
+        while (offset < total) {
+            const page = await fetchRemotePage(config!, charId, offset, pageSize, 'self_room');
+            remoteRoom.push(...(page.memories || []));
+            total = Number.isFinite(page.total) ? page.total : remoteRoom.length;
+            if (!page.memories?.length || remoteRoom.length >= total) break;
+            offset += page.memories.length;
+        }
+        const remoteCandidates = remoteRoom.filter(isSelfNarrativeRecord);
+        const remoteIds = new Set(remoteCandidates.map(node => node.id));
+        const localCandidates = (await MemoryNodeDB.getByCharId(charId)).filter(isSelfNarrativeRecord);
+
+        await MemoryNodeDB.saveManyLocal(remoteCandidates);
+        for (const node of localCandidates) {
+            if (!remoteIds.has(node.id)) await MemoryNodeDB.deleteLocal(node.id);
+        }
+        selfNarrativeLastRefresh.set(charId, Date.now());
+        return remoteCandidates;
+    })().finally(() => selfNarrativeInFlight.delete(charId));
+
+    selfNarrativeInFlight.set(charId, task);
+    return task;
+}
+
+/** Rebuild the local node cache from Ombre without writing the snapshot back. */
+export async function refreshAuthoritativeCache(
+    charId: string,
+    config?: RemoteVectorConfig,
+    force = false,
+): Promise<MemoryNode[]> {
+    // In rolling mode Ombre is an explicit archive target, not an automatic local mirror.
+    if (isRollingCycleEnabled()) return MemoryNodeDB.getByCharId(charId);
+    if (!isOmbreAuthoritative(config)) return MemoryNodeDB.getByCharId(charId);
+
+    const now = Date.now();
+    if (!force && now - (lastRefresh.get(charId) || 0) < REFRESH_INTERVAL_MS) {
+        return MemoryNodeDB.getByCharId(charId);
+    }
+    const running = inFlight.get(charId);
+    if (running) return running;
+
+    const task = (async () => {
+        const remote: MemoryNode[] = [];
+        const pageSize = 100;
+        let offset = 0;
+        let total = Number.POSITIVE_INFINITY;
+        while (offset < total) {
+            const page = await fetchRemotePage(config!, charId, offset, pageSize);
+            remote.push(...(page.memories || []));
+            total = Number.isFinite(page.total) ? page.total : remote.length;
+            if (!page.memories?.length || remote.length >= total) break;
+            offset += page.memories.length;
+        }
+
+        const local = await MemoryNodeDB.getByCharId(charId);
+        const remoteIds = new Set(remote.map(node => node.id));
+        await MemoryNodeDB.saveManyLocal(remote);
+        for (const node of local) {
+            if (!remoteIds.has(node.id)) await MemoryNodeDB.deleteLocal(node.id);
+        }
+        lastRefresh.set(charId, Date.now());
+        return remote;
+    })().finally(() => inFlight.delete(charId));
+
+    inFlight.set(charId, task);
+    return task;
+}
