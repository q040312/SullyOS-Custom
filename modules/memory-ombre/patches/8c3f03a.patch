+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode } from './types';
+import {
+    ROLLING_CYCLE_MAX_AGE_MS,
+    ROLLING_CYCLE_NODE_LIMIT,
+    assessRollingCycle,
+    attachNodesToRollingCycle,
+    createRollingCycle,
+    ensureRollingCycleState,
+    ensureNodeInActiveRollingCycle,
+    isRecallableLocalCycleNode,
+    readRollingCycleState,
+    startNextRollingCycle,
+    writeRollingCycleState,
+} from './rollingCycle';
+
+function node(id: string, overrides: Partial<MemoryNode> = {}): MemoryNode {
+    return {
+        id,
+        charId: 'yanke',
+        content: `memory ${id}`,
+        room: 'study',
+        tags: [],
+        importance: 5,
+        mood: 'neutral',
+        embedded: true,
+        createdAt: 1,
+        lastAccessedAt: 1,
+        accessCount: 0,
+        origin: 'extraction',
+        ...overrides,
+    };
+}
+
+describe('rolling memory cycles', () => {
+    beforeEach(() => {
+        vi.stubEnv('VITE_MEMORY_ROLLING_CYCLES', '1');
+        localStorage.clear();
+    });
+
+    it('starts at the current message high-water mark and persists', () => {
+        const state = ensureRollingCycleState('yanke', 4156, 1_000);
+        expect(state.active.startHighWaterMark).toBe(4156);
+        expect(readRollingCycleState('yanke')?.active.id).toBe(state.active.id);
+    });
+
+    it('tags local nodes but never tags Ombre mirrors', () => {
+        const local = node('local');
+        const mirror = node('mirror', { origin: 'ombre' });
+        attachNodesToRollingCycle([local, mirror], 'cycle-1');
+        expect(local.localCycleId).toBe('cycle-1');
+        expect(mirror.localCycleId).toBeUndefined();
+    });
+
+    it('becomes due at 150 active local memories', () => {
+        const cycle = createRollingCycle('yanke', 0, 1_000);
+        const nodes = Array.from({ length: ROLLING_CYCLE_NODE_LIMIT }, (_, i) =>
+            node(String(i), { localCycleId: cycle.id })
+        );
+        expect(assessRollingCycle(nodes, cycle, 2_000)).toMatchObject({
+            due: true,
+            reason: 'node_limit',
+            nodeCount: 150,
+        });
+    });
+
+    it('becomes due after three days even below the node limit', () => {
+        const cycle = createRollingCycle('yanke', 0, 1_000);
+        const nodes = [node('one', { localCycleId: cycle.id })];
+        expect(assessRollingCycle(nodes, cycle, 1_000 + ROLLING_CYCLE_MAX_AGE_MS)).toMatchObject({
+            due: true,
+            reason: 'age_limit',
+        });
+    });
+
+    it('does not count mirrors, archived nodes, or already committed nodes', () => {
+        const cycle = createRollingCycle('yanke', 0, 1_000);
+        const nodes = [
+            node('valid', { localCycleId: cycle.id }),
+            node('mirror', { origin: 'ombre', localCycleId: cycle.id }),
+            node('archived', { localCycleId: cycle.id, archived: true }),
+            node('committed', { localCycleId: cycle.id, archivedToOmbreAt: 9_999 }),
+        ];
+        expect(assessRollingCycle(nodes, cycle, 2_000).nodeCount).toBe(1);
+    });
+
+    it('keeps the previous cycle in bounded history', () => {
+        const first = ensureRollingCycleState('yanke', 100, 1_000);
+        first.active.status = 'cleaned';
+        const second = startNextRollingCycle(first, 200, 2_000);
+        expect(second.history).toHaveLength(1);
+        expect(second.history[0].status).toBe('cleaned');
+        expect(second.active.startHighWaterMark).toBe(200);
+    });
+
+    it('uses unique ids without moving startedAt into the future', () => {
+        const first = ensureRollingCycleState('yanke', 100, 2_000);
+        const second = startNextRollingCycle(first, 200, 2_000);
+        expect(second.active.id).not.toBe(first.active.id);
+        expect(second.active.startedAt).toBe(2_000);
+    });
+
+    it('normalizes legacy ledgers and keeps failed cycles recallable', () => {
+        const first = ensureRollingCycleState('yanke', 100, 1_000);
+        first.active.status = 'failed';
+        const second = startNextRollingCycle(first, 200, 2_000);
+        const raw = JSON.parse(localStorage.getItem('mp_cycle_state_yanke')!);
+        delete raw.history[0].committedNodeIds;
+        delete raw.history[0].cleanupSnapshotRecorded;
+        localStorage.setItem('mp_cycle_state_yanke', JSON.stringify(raw));
+
+        const restored = readRollingCycleState('yanke')!;
+        const failedNode = node('failed', { localCycleId: first.active.id });
+        expect(restored.history[0].committedNodeIds).toEqual([]);
+        expect(restored.history[0].cleanupSnapshotRecorded).toBe(false);
+        expect(isRecallableLocalCycleNode(failedNode, restored)).toBe(true);
+
+        writeRollingCycleState(restored);
+        expect(ensureNodeInActiveRollingCycle(failedNode)).toBe(true);
+        expect(failedNode.localCycleId).toBe(second.active.id);
+    });
+});
