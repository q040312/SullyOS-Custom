+import type { Message } from '../../types';
+import type { MemoryNode } from './types';
+import { sanitizeQuerySourceMessages } from './querySanitizer';
+import { isSelfNarrativeAccepted } from './selfNarrative';
+
+export const SELF_NARRATIVE_CONTEXT_CONTENT_BUDGET = 700;
+export const SELF_NARRATIVE_CONTEXT_MAX_ITEMS = 2;
+const HAN_RE = /[\p{Script=Han}]+/gu;
+const WORD_RE = /[a-z0-9][a-z0-9_-]+/giu;
+const STOP_TOKENS = new Set(['\u6211\u4eec', '\u4f60\u4eec', '\u4ed6\u4eec', '\u5979\u4eec', '\u81ea\u5df1', '\u8fd9\u4e2a', '\u90a3\u4e2a', '\u4e00\u79cd', '\u4e00\u4e2a', '\u4ec0\u4e48', '\u600e\u4e48', '\u4e3a\u4ec0\u4e48', '\u65f6\u5019', '\u73b0\u5728', '\u8fd8\u662f', '\u5c31\u662f', '\u53ef\u4ee5', '\u89c9\u5f97']);
+function collectTokens(text: string): Set<string> { const out = new Set<string>(); const normalized = text.toLowerCase(); for (const match of normalized.matchAll(WORD_RE)) if (match[0].length >= 2) out.add(match[0]); for (const match of normalized.matchAll(HAN_RE)) { const run = match[0]; if (run.length === 1) continue; if (run.length <= 4 && !STOP_TOKENS.has(run)) out.add(run); for (let i = 0; i < run.length - 1; i++) { const token = run.slice(i, i + 2); if (!STOP_TOKENS.has(token)) out.add(token); } } return out; }
+function relevanceScore(node: MemoryNode, queryTokens: Set<string>): number { if (!queryTokens.size) return 0; const nodeTokens = collectTokens(`${node.content}\n${node.tags.join(' ')}`); let overlap = 0; for (const token of queryTokens) if (nodeTokens.has(token)) overlap += token.length >= 3 ? 2 : 1; return overlap ? overlap * 100 + Math.max(0, Math.min(10, node.importance || 0)) + Math.min(5, (node.accessCount || 0) * 0.1) : 0; }
+
+export function buildSelfNarrativeQuery(recentMessages: Message[], queryHint?: string, charName?: string, userName?: string): string { const cleaned = sanitizeQuerySourceMessages(recentMessages, charName, userName); const userTexts = cleaned.filter(message => message.role === 'user').slice(-3).map(message => message.content.trim()).filter(Boolean); return [queryHint?.trim(), ...userTexts].filter(Boolean).join('\n').slice(-1600); }
+export function selectAcceptedSelfNarratives(nodes: MemoryNode[], query: string, contentBudget = SELF_NARRATIVE_CONTEXT_CONTENT_BUDGET, maxItems = SELF_NARRATIVE_CONTEXT_MAX_ITEMS): MemoryNode[] { if (contentBudget <= 0 || maxItems <= 0) return []; const queryTokens = collectTokens(query); const ranked = nodes.filter(isSelfNarrativeAccepted).map(node => ({ node, score: relevanceScore(node, queryTokens) })).filter(item => item.score > 0).sort((a, b) => b.score - a.score || b.node.importance - a.node.importance || b.node.createdAt - a.node.createdAt); const selected: MemoryNode[] = []; let used = 0; for (const { node } of ranked) { const content = node.content.trim(); if (!content) continue; const remaining = contentBudget - used; if (remaining <= 0) break; const clipped = content.length > remaining ? `${content.slice(0, Math.max(0, remaining - 1)).trimEnd()}\u2026` : content; if (!clipped) break; selected.push(clipped === node.content ? node : { ...node, content: clipped }); used += clipped.length; if (selected.length >= maxItems) break; } return selected; }
+export function formatAcceptedSelfNarrativeContext(nodes: MemoryNode[]): string { if (!nodes.length) return ''; const items = nodes.map(node => `- ${node.content.trim()}`).join('\n'); return `\n\n### \u5df2\u91c7\u7eb3\u7684\u7b2c\u4e00\u4eba\u79f0\u81ea\u8ff0\uff08\u52a8\u6001\u53c2\u8003\uff09\n\u4ee5\u4e0b\u5185\u5bb9\u662f\u7ecf\u8fc7\u7528\u6237\u5ba1\u9605\u91c7\u7eb3\u7684\u65e2\u5f80\u81ea\u8ff0\u3002\u53ea\u5728\u4e0e\u5f53\u524d\u8bdd\u9898\u76f4\u63a5\u76f8\u5173\u65f6\u53c2\u8003\uff1b\u4e0d\u8981\u673a\u68b0\u590d\u8ff0\uff0c\u4e0d\u8981\u628a\u5b83\u5f3a\u884c\u5e26\u5165\u65e0\u5173\u56de\u7b54\uff0c\u4e5f\u4e0d\u8981\u628a\u5b83\u5f53\u4f5c\u4e0d\u53ef\u4fee\u6539\u7684\u56fa\u5b9a\u4eba\u683c\u3002\n${items}`; }
