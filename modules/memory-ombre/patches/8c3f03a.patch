@@ -0,0 +1,49 @@
+import type { MemoryNode } from './types';
+import { SELF_NARRATIVE_TAG, isSelfNarrativeAccepted } from './selfNarrative';
+
+export const STABLE_COGNITION_TAG = '\u7a33\u5b9a\u81ea\u6211\u8ba4\u77e5';
+export const STABLE_COGNITION_DOWNGRADED_TAG = '\u7a33\u5b9a\u8ba4\u77e5\u5df2\u964d\u7ea7';
+export interface StableCognitionEvidence { id: string; date: string; snapshot: string; }
+export interface StableCognitionData { conclusion: string; conditions: string; counterexamples: string; scenes: string[]; evidence: StableCognitionEvidence[]; revisedAt: string; }
+export interface StableCognitionInput { conclusion: string; conditions: string; counterexamples?: string; scenes: string[]; }
+
+const FIELD_RE = /^\u3010([^\u3011]+)\u3011(.*)$/;
+const SEP = '\u2502';
+function cleanLine(value: string, maxLength: number): string { return value.replace(/\s+/g, ' ').trim().slice(0, maxLength); }
+function unique(values: string[]): string[] { return [...new Set(values.map(value => value.trim()).filter(Boolean))]; }
+
+export function serializeStableCognition(data: StableCognitionData): string {
+    const evidence = data.evidence.map(item => `- ${item.date}${SEP}${item.id}${SEP}${cleanLine(item.snapshot, 260)}`).join('\n');
+    return [`\u3010\u7a33\u5b9a\u8ba4\u77e5\u3011${cleanLine(data.conclusion, 600)}`, `\u3010\u9002\u7528\u6761\u4ef6\u3011${cleanLine(data.conditions, 500)}`, `\u3010\u53cd\u4f8b\u3011${cleanLine(data.counterexamples || '\u6682\u65e0', 500)}`, `\u3010\u573a\u666f\u3011${unique(data.scenes).join(SEP)}`, '\u3010\u652f\u6301\u8bc1\u636e\u3011', evidence, `\u3010\u4fee\u8ba2\u65f6\u95f4\u3011${data.revisedAt}`].join('\n');
+}
+
+export function parseStableCognition(content: string): StableCognitionData | null {
+    const data: StableCognitionData = { conclusion: '', conditions: '', counterexamples: '', scenes: [], evidence: [], revisedAt: '' };
+    let field = '';
+    for (const rawLine of content.split(/\r?\n/)) {
+        const line = rawLine.trim(); const match = line.match(FIELD_RE);
+        if (match) { field = match[1]; const value = match[2].trim(); if (field === '\u7a33\u5b9a\u8ba4\u77e5') data.conclusion = value; else if (field === '\u9002\u7528\u6761\u4ef6') data.conditions = value; else if (field === '\u53cd\u4f8b') data.counterexamples = value; else if (field === '\u573a\u666f') data.scenes = unique(value.split(SEP)); else if (field === '\u4fee\u8ba2\u65f6\u95f4') data.revisedAt = value; continue; }
+        if (field === '\u652f\u6301\u8bc1\u636e' && line.startsWith('- ')) { const [date = '', id = '', ...snapshotParts] = line.slice(2).split(SEP); if (id.trim()) data.evidence.push({ date: date.trim(), id: id.trim(), snapshot: snapshotParts.join(SEP).trim() }); }
+    }
+    return data.conclusion && data.conditions ? data : null;
+}
+
+export function isStableCognitionRecord(node: MemoryNode): boolean { return !!node.archived && node.tags.includes(SELF_NARRATIVE_TAG) && node.tags.includes(STABLE_COGNITION_TAG); }
+export function isStableCognition(node: MemoryNode): boolean { return isStableCognitionRecord(node) && !node.tags.includes(STABLE_COGNITION_DOWNGRADED_TAG); }
+
+export function createStableCognition(charId: string, acceptedEvidence: MemoryNode[], input: StableCognitionInput, now = Date.now()): MemoryNode {
+    const evidenceNodes = [...new Map(acceptedEvidence.filter(isSelfNarrativeAccepted).map(node => [node.id, node])).values()];
+    if (evidenceNodes.length < 2) throw new Error('\u81f3\u5c11\u9009\u62e9 2 \u6761\u5df2\u91c7\u7eb3\u81ea\u8ff0\u4f5c\u4e3a\u8bc1\u636e');
+    if (unique(evidenceNodes.map(node => new Date(node.createdAt).toISOString().slice(0, 10))).length < 2) throw new Error('\u8bc1\u636e\u81f3\u5c11\u8981\u6765\u81ea 2 \u4e2a\u4e0d\u540c\u65e5\u671f');
+    const scenes = unique(input.scenes); if (scenes.length < 2) throw new Error('\u81f3\u5c11\u586b\u5199 2 \u4e2a\u4e0d\u540c\u573a\u666f');
+    const conclusion = cleanLine(input.conclusion, 600); const conditions = cleanLine(input.conditions, 500); if (!conclusion || !conditions) throw new Error('\u7a33\u5b9a\u8ba4\u77e5\u548c\u9002\u7528\u6761\u4ef6\u4e0d\u80fd\u4e3a\u7a7a');
+    const data: StableCognitionData = { conclusion, conditions, counterexamples: cleanLine(input.counterexamples || '\u6682\u65e0', 500), scenes, evidence: evidenceNodes.slice(0, 8).map(node => ({ id: node.id, date: new Date(node.createdAt).toISOString().slice(0, 10), snapshot: node.content })), revisedAt: new Date(now).toISOString() };
+    return { id: `stable_cognition_${charId}_${now}_${Math.random().toString(36).slice(2, 8)}`, charId, content: serializeStableCognition(data), room: 'self_room', tags: [SELF_NARRATIVE_TAG, STABLE_COGNITION_TAG], importance: 9, mood: 'reflective', embedded: false, createdAt: now, lastAccessedAt: now, accessCount: 0, sourceId: evidenceNodes[0].id, origin: 'digestion', archived: true };
+}
+
+export function reviseStableCognition(node: MemoryNode, input: Pick<StableCognitionInput, 'conclusion' | 'conditions' | 'counterexamples'>, now = Date.now()): MemoryNode {
+    const existing = parseStableCognition(node.content); if (!existing) throw new Error('\u65e0\u6cd5\u89e3\u6790\u8fd9\u6761\u7a33\u5b9a\u8ba4\u77e5');
