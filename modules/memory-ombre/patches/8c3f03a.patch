+import { describe, expect, it } from 'vitest';
+import type { MemoryNode } from './types';
+import { SELF_NARRATIVE_ACCEPTED_TAG, SELF_NARRATIVE_TAG } from './selfNarrative';
+import { STABLE_COGNITION_DOWNGRADED_TAG, STABLE_COGNITION_TAG, createStableCognition, downgradeStableCognition, isStableCognition, parseStableCognition, reviseStableCognition } from './stableCognition';
+function evidence(id: string, createdAt: number): MemoryNode { return { id, charId: 'yanke', content: `evidence ${id}`, room: 'self_room', tags: [SELF_NARRATIVE_TAG, SELF_NARRATIVE_ACCEPTED_TAG], importance: 8, mood: 'reflective', embedded: false, archived: true, createdAt, lastAccessedAt: createdAt, accessCount: 0 }; }
+describe('stable cognition isolation', () => {
+    it('requires cross-day accepted evidence and creates an archived non-embedded self-room record', () => { const record = createStableCognition('yanke', [evidence('one', Date.UTC(2026, 0, 1)), evidence('two', Date.UTC(2026, 0, 2))], { conclusion: 'I listen first', conditions: 'when emotions are high', scenes: ['conflict', 'comfort'] }, Date.UTC(2026, 0, 3)); expect(record).toMatchObject({ room: 'self_room', archived: true, embedded: false }); expect(record.tags).toEqual(expect.arrayContaining([SELF_NARRATIVE_TAG, STABLE_COGNITION_TAG])); expect(parseStableCognition(record.content)?.conclusion).toBe('I listen first'); expect(isStableCognition(record)).toBe(true); });
+    it('revises and downgrades without exposing the record', () => { const record = createStableCognition('yanke', [evidence('one', Date.UTC(2026, 0, 1)), evidence('two', Date.UTC(2026, 0, 2))], { conclusion: 'I listen first', conditions: 'when emotions are high', scenes: ['conflict', 'comfort'] }, Date.UTC(2026, 0, 3)); const revised = reviseStableCognition(record, { conclusion: 'I ask first', conditions: 'when uncertain' }, Date.UTC(2026, 0, 4)); const downgraded = downgradeStableCognition(revised); expect(downgraded.tags).toContain(STABLE_COGNITION_DOWNGRADED_TAG); expect(downgraded).toMatchObject({ archived: true, embedded: false }); expect(isStableCognition(downgraded)).toBe(false); });
+});
