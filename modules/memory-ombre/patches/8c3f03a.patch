@@ -0,0 +1,101 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode, RemoteVectorConfig } from './types';
+
+const mocks = vi.hoisted(() => ({
+    fetchRemotePage: vi.fn(),
+    getByCharId: vi.fn(),
+    saveManyLocal: vi.fn(),
+    deleteLocal: vi.fn(),
+}));
+
+vi.mock('./authority', () => ({
+    isOmbreAuthoritative: () => true,
+}));
+
+vi.mock('./remoteVector', () => ({
+    fetchRemotePage: mocks.fetchRemotePage,
+}));
+
+vi.mock('./db', () => ({
+    MemoryNodeDB: {
+        getByCharId: mocks.getByCharId,
+        saveManyLocal: mocks.saveManyLocal,
+        deleteLocal: mocks.deleteLocal,
+    },
+}));
+
+import { refreshSelfNarrativeCandidateCache } from './authoritativeCache';
+
+const config: RemoteVectorConfig = {
+    enabled: true,
+    initialized: true,
+    provider: 'ombre',
+    supabaseUrl: '',
+    supabaseAnonKey: '',
+    ombreUrl: '/sully-memory',
+};
+
+function node(id: string, tags: string[], archived = true): MemoryNode {
+    return {
+        id,
+        charId: 'yanke',
+        content: id,
+        room: 'self_room',
+        tags,
+        importance: 5,
+        mood: 'neutral',
+        embedded: false,
+        archived,
+        createdAt: 1,
+        lastAccessedAt: 1,
+        accessCount: 0,
+    };
+}
+
+describe('self narrative authoritative cache', () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+        mocks.saveManyLocal.mockResolvedValue(undefined);
+        mocks.deleteLocal.mockResolvedValue(undefined);
+    });
+
+    it('mirrors only management candidates while rolling mode remains enabled', async () => {
+        const candidate = node('candidate', ['第一人称自述', '自述候选']);
+        const accepted = node('accepted', ['第一人称自述', '自述已采纳']);
+        const misjudged = node('misjudged', ['第一人称自述', '自述误判']);
+        const ordinaryRemote = node('ordinary-remote', ['自我认知'], false);
+        const staleCandidate = node('stale', ['第一人称自述', '自述候选']);
+        const staleAccepted = node('stale-accepted', ['第一人称自述', '自述已采纳']);
+        const staleMisjudged = node('stale-misjudged', ['第一人称自述', '自述误判']);
+        const ordinaryLocal = node('ordinary-local', ['人格风格'], false);
+
+        mocks.fetchRemotePage.mockResolvedValue({
+            memories: [candidate, accepted, misjudged, ordinaryRemote],
+            total: 4,
+            offset: 0,
+            limit: 100,
+        });
+        mocks.getByCharId.mockResolvedValue([staleCandidate, staleAccepted, staleMisjudged, ordinaryLocal]);
+
+        await expect(refreshSelfNarrativeCandidateCache('yanke', config)).resolves.toEqual([
+            candidate,
+            accepted,
+            misjudged,
+        ]);
+        expect(mocks.fetchRemotePage).toHaveBeenCalledWith(config, 'yanke', 0, 100, 'self_room');
+        expect(mocks.saveManyLocal).toHaveBeenCalledWith([candidate, accepted, misjudged]);
+        expect(mocks.deleteLocal).toHaveBeenCalledWith('stale');
+        expect(mocks.deleteLocal).toHaveBeenCalledWith('stale-accepted');
+        expect(mocks.deleteLocal).toHaveBeenCalledWith('stale-misjudged');
+        expect(mocks.deleteLocal).not.toHaveBeenCalledWith('ordinary-local');
+    });
+
+    it('does not clear the offline cache when the remote request fails', async () => {
+        mocks.fetchRemotePage.mockRejectedValue(new Error('offline'));
+        mocks.getByCharId.mockResolvedValue([node('cached', ['第一人称自述', '自述候选'])]);
+
+        await expect(refreshSelfNarrativeCandidateCache('yanke', config, true)).rejects.toThrow('offline');
+        expect(mocks.saveManyLocal).not.toHaveBeenCalled();
+        expect(mocks.deleteLocal).not.toHaveBeenCalled();
+    });
+});
