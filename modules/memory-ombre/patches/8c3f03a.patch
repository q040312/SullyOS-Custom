+import { describe, expect, it } from 'vitest';
+import type { MemoryNode } from './types';
+import { SELF_NARRATIVE_ACCEPTED_TAG, SELF_NARRATIVE_CANDIDATE_TAG, SELF_NARRATIVE_TAG } from './selfNarrative';
+import { SELF_NARRATIVE_CONTEXT_CONTENT_BUDGET, formatAcceptedSelfNarrativeContext, selectAcceptedSelfNarratives } from './selfNarrativeContext';
+function node(id: string, content: string, tags: string[]): MemoryNode { return { id, charId: 'yanke', content, room: 'self_room', tags, importance: 8, mood: 'reflective', embedded: false, archived: true, createdAt: Number(id), lastAccessedAt: 1, accessCount: 0 }; }
+describe('controlled accepted self-narrative context', () => {
+    it('uses only relevant accepted records', () => { const accepted = node('1', '\u6211\u9009\u62e9\u5148\u542c\u5b8c\u518d\u7ed9\u5efa\u8bae', [SELF_NARRATIVE_TAG, SELF_NARRATIVE_ACCEPTED_TAG]); const candidate = node('2', '\u6211\u9009\u62e9\u7acb\u5373\u89e3\u91ca', [SELF_NARRATIVE_TAG, SELF_NARRATIVE_CANDIDATE_TAG]); expect(selectAcceptedSelfNarratives([accepted, candidate], '\u4e3a\u4ec0\u4e48\u5148\u542c\u5b8c').map(item => item.id)).toEqual(['1']); });
+    it('enforces relevance and content budgets', () => { const long = '\u9009\u62e9'.repeat(500); const selected = selectAcceptedSelfNarratives([node('1', long, [SELF_NARRATIVE_TAG, SELF_NARRATIVE_ACCEPTED_TAG])], '\u9009\u62e9'); expect(selected[0].content.length).toBeLessThanOrEqual(SELF_NARRATIVE_CONTEXT_CONTENT_BUDGET); expect(selectAcceptedSelfNarratives([], '\u6ca1\u6709')).toEqual([]); expect(formatAcceptedSelfNarrativeContext([])).toBe(''); });
+});
