+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { MemoryNode, RemoteVectorConfig } from './types';
+
+const mocks = vi.hoisted(() => ({
+    saveNode: vi.fn(),
+    saveVector: vi.fn(),
+    getVectors: vi.fn(),
+    getNodes: vi.fn(),
+    remoteUpsert: vi.fn(),
+    getEmbeddings: vi.fn(),
+}));
+
+vi.mock('./db', () => ({
+    MemoryNodeDB: {
+        save: mocks.saveNode,
+        getByCharId: mocks.getNodes,
+    },
+    MemoryVectorDB: {
+        save: mocks.saveVector,
+        getAllByCharId: mocks.getVectors,
+    },
+    ensureFloat32: (value: Float32Array) => value,
+}));
+vi.mock('./embedding', () => ({
+    getEmbeddings: mocks.getEmbeddings,
+    cosineSimilarity: vi.fn(() => 0),
+}));
+vi.mock('./remoteVector', () => ({ upsertVector: mocks.remoteUpsert }));
+vi.mock('./authority', () => ({ isOmbreAuthoritative: vi.fn(() => false) }));
+
+import { ensureRollingCycleState } from './rollingCycle';
+import { rebuildAllVectors, vectorizeAndStore } from './vectorStore';
+
+const remote = {
+    enabled: true,
+    initialized: true,
+    provider: 'supabase',
+} as RemoteVectorConfig;
+const embedding = {
+    baseUrl: 'https://embedding.invalid',
+    apiKey: 'x',
+    model: 'm',
+    dimensions: 3,
+};
+const node = (localCycleId: string): MemoryNode => ({
+    id: 'local',
+    charId: 'yanke',
+    content: 'local cycle memory',
+    room: 'study',
+    tags: [],
+    importance: 5,
+    mood: 'neutral',
+    embedded: true,
+    createdAt: 1,
+    lastAccessedAt: 1,
+    accessCount: 0,
+    origin: 'extraction',
+    localCycleId,
+});
+
+describe('vector store rolling-cycle isolation', () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+        vi.stubEnv('VITE_MEMORY_ROLLING_CYCLES', '1');
+        localStorage.clear();
+        mocks.getVectors.mockResolvedValue([]);
+        mocks.getEmbeddings.mockResolvedValue([new Float32Array([1, 0, 0])]);
+    });
+
+    it('never upserts newly vectorized or rebuilt local-cycle nodes', async () => {
+        const state = ensureRollingCycleState('yanke', 0, 1_000);
+        const local = node(state.active.id);
+        mocks.getNodes.mockResolvedValue([local]);
+
+        await vectorizeAndStore([local], embedding, remote, { skipDedup: true });
+        await rebuildAllVectors('yanke', embedding, remote);
+
+        expect(mocks.saveNode).toHaveBeenCalled();
+        expect(mocks.saveVector).toHaveBeenCalledTimes(2);
+        expect(mocks.remoteUpsert).not.toHaveBeenCalled();
+    });
+});
