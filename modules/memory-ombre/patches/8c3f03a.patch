@@ -0,0 +1,61 @@
+/** SullyOS <-> Ombre long-term memory adapter. Ombre owns embeddings. */
+import type { MemoryNode, RemoteVectorConfig } from './types';
+import { ownedServiceCredentials, resolveOmbreMemoryUrl, sullyAppAuthHeaders } from '../deploymentUrls';
+
+export interface RemoteMemoryHit {
+    memoryId: string; content: string; similarity: number; room: string; importance: number; tags: string[]; mood: string;
+    valence: number | null; arousal: number | null; createdAt: number; lastAccessedAt: number; accessCount: number;
+    pinnedUntil: number | null; sourceId: string | null; origin: string | null; archived: boolean; isSummary: boolean; eventBoxId: string | null;
+}
+
+function baseUrl(config: RemoteVectorConfig): string { return resolveOmbreMemoryUrl(config.ombreUrl); }
+function headers(config: RemoteVectorConfig): Record<string, string> {
+    const result: Record<string, string> = { 'Content-Type': 'application/json', ...sullyAppAuthHeaders() };
+    if (config.ombreToken) result['X-Sully-Memory-Token'] = config.ombreToken;
+    return result;
+}
+async function jsonRequest<T>(config: RemoteVectorConfig, path: string, init?: RequestInit): Promise<T> {
+    const response = await fetch(`${baseUrl(config)}${path}`, { credentials: ownedServiceCredentials, ...init, headers: { ...headers(config), ...(init?.headers || {}) } });
+    if (!response.ok) throw new Error(`Ombre HTTP ${response.status}`);
+    return response.json() as Promise<T>;
+}
+function nodePayload(memoryId: string, charId: string, node: MemoryNode, dimensions?: number, model?: string) { return { memoryId, charId, dimensions, model, node }; }
+
+export async function testConnection(config: RemoteVectorConfig): Promise<{ ok: boolean; tableExists: boolean; message: string }> {
+    try { const result = await jsonRequest<{ ok: boolean; message?: string }>(config, '/health'); return { ok: !!result.ok, tableExists: !!result.ok, message: result.message || (result.ok ? 'Ombre memory connected' : 'Ombre memory unavailable') }; }
+    catch (error: unknown) { return { ok: false, tableExists: false, message: `Connection failed: ${error instanceof Error ? error.message : 'unknown error'}` }; }
+}
+export async function upsertVector(config: RemoteVectorConfig, memoryId: string, charId: string, _vector: number[] | Float32Array | Uint8Array, node: MemoryNode, dimensions: number, model?: string): Promise<boolean> {
+    try { await jsonRequest(config, '/memories', { method: 'POST', body: JSON.stringify(nodePayload(memoryId, charId, node, dimensions, model)) }); return true; } catch { return false; }
+}
+export async function upsertVectorBatch(config: RemoteVectorConfig, items: { memoryId: string; charId: string; vector: number[] | Float32Array | Uint8Array; node: MemoryNode; dimensions: number; model?: string }[]): Promise<boolean> {
+    if (!items.length) return true;
+    try { await jsonRequest(config, '/memories/batch', { method: 'POST', body: JSON.stringify({ items: items.map(({ memoryId, charId, node, dimensions, model }) => nodePayload(memoryId, charId, node, dimensions, model)) }) }); return true; } catch { return false; }
+}
+export async function searchVectors(config: RemoteVectorConfig, _queryVector: number[] | Float32Array | Uint8Array, charId: string, threshold = 0.3, topK = 20, queryText?: string): Promise<RemoteMemoryHit[]> {
+    if (!queryText?.trim()) throw new Error('Ombre search requires query text');
+    const result = await jsonRequest<{ results: RemoteMemoryHit[] }>(config, '/search', { method: 'POST', body: JSON.stringify({ query: queryText, charId, threshold, topK }) });
+    return result.results || [];
+}
+export async function fetchRemoteByRoom(config: RemoteVectorConfig, charId: string, room: string, limit = 50): Promise<MemoryNode[]> {
+    try { const query = new URLSearchParams({ charId, room, limit: String(limit) }); const result = await jsonRequest<{ memories: MemoryNode[] }>(config, `/memories?${query}`); return result.memories || []; } catch { return []; }
+}
+export interface RemoteMemoryPage { memories: MemoryNode[]; total: number; offset: number; limit: number; }
+export async function fetchRemotePage(config: RemoteVectorConfig, charId: string, offset = 0, limit = 100, room?: string): Promise<RemoteMemoryPage> {
+    const query = new URLSearchParams({ charId, offset: String(offset), limit: String(limit) }); if (room) query.set('room', room); return jsonRequest<RemoteMemoryPage>(config, `/memories?${query}`);
+}
+async function bulkPatch(config: RemoteVectorConfig, memoryIds: string[], patch: Record<string, unknown>): Promise<boolean> {
+    if (!memoryIds.length) return true;
+    try { await jsonRequest(config, '/memories/bulk', { method: 'PATCH', body: JSON.stringify({ memoryIds, patch }) }); return true; } catch { return false; }
+}
+export const bulkSetArchived = (config: RemoteVectorConfig, memoryIds: string[], archived: boolean) => bulkPatch(config, memoryIds, { archived });
+export const bulkSetRoom = (config: RemoteVectorConfig, memoryIds: string[], room: string) => bulkPatch(config, memoryIds, { room });
+export async function deleteVector(config: RemoteVectorConfig, memoryId: string): Promise<boolean> { try { await jsonRequest(config, `/memories/${encodeURIComponent(memoryId)}`, { method: 'DELETE' }); return true; } catch { return false; } }
+export async function getVectorCount(config: RemoteVectorConfig, charId?: string): Promise<number> {
+    try { const query = charId ? `?${new URLSearchParams({ charId })}` : ''; const result = await jsonRequest<{ count: number }>(config, `/count${query}`); return Number(result.count) || 0; } catch { return 0; }
+}
+export async function syncLocalToRemote(config: RemoteVectorConfig, getLocalVectors: () => Promise<{ memoryId: string; charId: string; vector: number[] | Float32Array | Uint8Array; node: MemoryNode; dimensions: number; model?: string }[]>, onProgress?: (done: number, total: number) => void): Promise<{ synced: number; failed: number }> {
+    const items = await getLocalVectors(); let synced = 0; let failed = 0;
+    for (let i = 0; i < items.length; i += 25) { const batch = items.slice(i, i + 25); if (await upsertVectorBatch(config, batch)) synced += batch.length; else failed += batch.length; onProgress?.(Math.min(i + batch.length, items.length), items.length); }
+    return { synced, failed };
+}
