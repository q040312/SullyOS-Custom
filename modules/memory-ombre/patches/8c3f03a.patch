+import type { MemoryNode } from './types';
+
+export const SELF_NARRATIVE_TAG = '\u7b2c\u4e00\u4eba\u79f0\u81ea\u8ff0';
+export const SELF_NARRATIVE_CANDIDATE_TAG = '\u81ea\u8ff0\u5019\u9009';
+export const SELF_NARRATIVE_ACCEPTED_TAG = '\u81ea\u8ff0\u5df2\u91c7\u7eb3';
+export const SELF_NARRATIVE_OBSERVING_TAG = '\u7ee7\u7eed\u89c2\u5bdf';
+export const SELF_NARRATIVE_MISJUDGED_TAG = '\u81ea\u8ff0\u8bef\u5224';
+export const SELF_NARRATIVE_REVISED_TAG = '\u81ea\u8ff0\u5df2\u4fee\u8ba2';
+
+export function isSelfNarrativeCandidate(node: MemoryNode): boolean {
+    return !!node.archived && node.tags.includes(SELF_NARRATIVE_TAG) && node.tags.includes(SELF_NARRATIVE_CANDIDATE_TAG);
+}
+
+export function isSelfNarrativeAccepted(node: MemoryNode): boolean {
+    return !!node.archived && node.tags.includes(SELF_NARRATIVE_TAG) && node.tags.includes(SELF_NARRATIVE_ACCEPTED_TAG);
+}
+
+export function isSelfNarrativeMisjudged(node: MemoryNode): boolean {
+    return !!node.archived && node.tags.includes(SELF_NARRATIVE_TAG) && node.tags.includes(SELF_NARRATIVE_MISJUDGED_TAG);
+}
+
+export function isSelfNarrativeRecord(node: MemoryNode): boolean {
+    return isSelfNarrativeCandidate(node) || isSelfNarrativeAccepted(node) || isSelfNarrativeMisjudged(node)
+        || (!!node.archived && node.tags.includes(SELF_NARRATIVE_TAG) && node.tags.includes('\u7a33\u5b9a\u81ea\u6211\u8ba4\u77e5'));
+}
+
+export function acceptSelfNarrative(node: MemoryNode): MemoryNode {
+    const tags = node.tags.filter(tag => tag !== SELF_NARRATIVE_CANDIDATE_TAG && tag !== SELF_NARRATIVE_OBSERVING_TAG && tag !== SELF_NARRATIVE_ACCEPTED_TAG);
+    return { ...node, room: 'self_room', tags: [SELF_NARRATIVE_TAG, SELF_NARRATIVE_ACCEPTED_TAG, ...tags.filter(tag => tag !== SELF_NARRATIVE_TAG)], archived: true, embedded: false };
+}
+
+export function observeSelfNarrative(node: MemoryNode): MemoryNode {
+    const tags = node.tags.filter(tag => tag !== SELF_NARRATIVE_OBSERVING_TAG && tag !== SELF_NARRATIVE_ACCEPTED_TAG);
+    return { ...node, room: 'self_room', tags: [SELF_NARRATIVE_TAG, SELF_NARRATIVE_CANDIDATE_TAG, SELF_NARRATIVE_OBSERVING_TAG, ...tags.filter(tag => tag !== SELF_NARRATIVE_TAG && tag !== SELF_NARRATIVE_CANDIDATE_TAG)], archived: true, embedded: false };
+}
+
+export function reviseSelfNarrative(node: MemoryNode, content: string): MemoryNode {
+    const revised = content.trim().slice(0, 600);
+    if (!revised) throw new Error('\u81ea\u8ff0\u6b63\u6587\u4e0d\u80fd\u4e3a\u7a7a');
+    return { ...node, content: revised, room: 'self_room', tags: node.tags.includes(SELF_NARRATIVE_REVISED_TAG) ? node.tags : [...node.tags, SELF_NARRATIVE_REVISED_TAG], archived: true, embedded: false };
+}
+
+export function markSelfNarrativeMisjudged(node: MemoryNode): MemoryNode {
+    const tags = node.tags.filter(tag => tag !== SELF_NARRATIVE_CANDIDATE_TAG && tag !== SELF_NARRATIVE_OBSERVING_TAG && tag !== SELF_NARRATIVE_ACCEPTED_TAG && tag !== SELF_NARRATIVE_MISJUDGED_TAG);
+    return { ...node, room: 'self_room', tags: [SELF_NARRATIVE_TAG, SELF_NARRATIVE_MISJUDGED_TAG, ...tags.filter(tag => tag !== SELF_NARRATIVE_TAG)], archived: true, embedded: false };
+}
+
+export function createSelfNarrativeCandidate(charId: string, source: MemoryNode, content: string, now = Date.now()): MemoryNode {
+    return {
+        id: `self_narrative_${charId}_${source.id}`,
+        charId, content: content.trim().slice(0, 600), room: 'self_room',
+        tags: [SELF_NARRATIVE_TAG, SELF_NARRATIVE_CANDIDATE_TAG, ...source.tags.filter(tag => tag !== SELF_NARRATIVE_TAG && tag !== SELF_NARRATIVE_CANDIDATE_TAG)],
+        importance: Math.max(6, Math.min(9, source.importance || 6)), mood: source.mood || 'reflective', valence: source.valence, arousal: source.arousal,
+        embedded: false, createdAt: now, lastAccessedAt: now, accessCount: 0, sourceId: source.id, origin: 'digestion', archived: true,
+    };
+}
