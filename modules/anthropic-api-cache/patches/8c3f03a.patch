+import type { AnthropicPromptCacheTtl } from '../types';
+
+export const isAnthropicPromptCacheEnabled = (config: { anthropicNative?: boolean; anthropicPromptCache?: boolean }): boolean =>
+  config.anthropicNative === true && config.anthropicPromptCache === true;
+
+/**
+ * Adds an Anthropic cache breakpoint only to Sully's stable system prefix.
+ * Runtime context, history, tool results and user-attached images stay dynamic.
+ */
+const withCacheBreakpoint = (content: any, ttl: AnthropicPromptCacheTtl): any => {
+  // Anthropic's five-minute retention is the default and must omit `ttl`.
+  const cache_control = ttl === '5m'
+    ? { type: 'ephemeral' }
+    : { type: 'ephemeral', ttl: '1h' };
+  if (typeof content === 'string') return [{ type: 'text', text: content, cache_control }];
+  if (Array.isArray(content)) {
+    const parts = content.map(part => part && typeof part === 'object' ? { ...part } : part);
+    for (let i = parts.length - 1; i >= 0; i -= 1) {
+      const part = parts[i];
+      if (part && typeof part === 'object' && part.type === 'text') {
+        parts[i] = { ...part, cache_control };
+        return parts;
+      }
+    }
+    return [...parts, { type: 'text', text: ' ', cache_control }];
+  }
+  return [{ type: 'text', text: String(content ?? ''), cache_control }];
+};
+
+export const applyAnthropicPromptCache = (messages: any[], ttl: AnthropicPromptCacheTtl = '1h'): any[] => {
+  const source = messages || [];
+  const stableIndex = source.findIndex(message => message?.role === 'system');
+  if (stableIndex < 0) return source;
+  return source.map((message, index) => index === stableIndex
+    ? { ...message, content: withCacheBreakpoint(message.content, ttl) }
+    : message);
+};
