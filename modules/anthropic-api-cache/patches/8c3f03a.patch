+import type { APIConfig } from '../types';
+import { resolveAnthropicMessagesUrl, toAnthropicRequest } from './anthropicNative';
+import { normalizeApiBaseUrl, normalizeApiCredential, normalizeApiModel } from './apiConfigNormalize';
+
+type ConnectionConfig = Pick<APIConfig, 'baseUrl' | 'apiKey' | 'model' | 'stream' | 'anthropicNative'>;
+
+export interface SettingsApiConnectionRequest {
+  url: string;
+  init: RequestInit;
+}
+
+/** Read text from a successful native Messages probe without exposing thinking blocks. */
+export const extractNativeSettingsConnectionReply = (response: unknown): string =>
+  Array.isArray((response as any)?.content)
+    ? (response as any).content
+      .filter((block: any) => block?.type === 'text')
+      .map((block: any) => String(block.text ?? ''))
+      .join('')
+    : '';
+
+/** Build the Settings connection probe with the same protocol selected for chat. */
+export const buildSettingsApiConnectionRequest = (config: ConnectionConfig): SettingsApiConnectionRequest => {
+  const baseUrl = normalizeApiBaseUrl(config.baseUrl);
+  const apiKey = normalizeApiCredential(config.apiKey);
+  const model = normalizeApiModel(config.model);
+  const body = {
+    model,
+    messages: [{ role: 'user', content: 'Hi' }],
+    max_tokens: 5,
+    stream: config.stream === true,
+  };
+
+  if (config.anthropicNative === true) {
