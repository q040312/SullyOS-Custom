+import { describe, expect, it } from 'vitest';
+import { applyAnthropicPromptCache, isAnthropicPromptCacheEnabled } from './anthropicPromptCache';
+
+describe('applyAnthropicPromptCache', () => {
+  it('marks only the stable first system text block', () => {
+    const result = applyAnthropicPromptCache([
+      { role: 'system', content: 'stable' },
+      { role: 'system', content: 'runtime' },
+      { role: 'user', content: [{ type: 'image_url', image_url: { url: 'https://example.test/image.png' } }] },
+      { role: 'tool', content: 'dynamic result' },
+    ]);
+    expect(result[0].content[0]).toMatchObject({
+      type: 'text',
+      text: 'stable',
+      cache_control: { type: 'ephemeral', ttl: '1h' },
+    });
+    expect(JSON.stringify(result.slice(1))).not.toContain('cache_control');
+  });
+  it('keeps the explicit one-hour TTL', () => {
+    const result = applyAnthropicPromptCache([{ role: 'system', content: 'stable' }], '1h');
+    expect(result[0].content[0].cache_control).toEqual({ type: 'ephemeral', ttl: '1h' });
+  });
+  it('uses Anthropic default retention for five minutes without sending ttl', () => {
+    const result = applyAnthropicPromptCache([{ role: 'system', content: 'stable' }], '5m');
+    expect(result[0].content[0].cache_control).toEqual({ type: 'ephemeral' });
+  });
+  it('never enables cache breakpoints for a non-native request', () => {
+    expect(isAnthropicPromptCacheEnabled({ anthropicNative: false, anthropicPromptCache: true })).toBe(false);
+    expect(isAnthropicPromptCacheEnabled({ anthropicNative: true, anthropicPromptCache: false })).toBe(false);
+    expect(isAnthropicPromptCacheEnabled({ anthropicNative: true, anthropicPromptCache: true })).toBe(true);
+  });
+});
