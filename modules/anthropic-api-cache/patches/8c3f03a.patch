new file mode 100644
index 0000000..f2920f0
--- /dev/null
+++ b/utils/anthropicNative.image.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from 'vitest';
+import { toAnthropicRequest } from './anthropicNative';
+
+describe('anthropic native image conversion', () => {
+    it('converts OpenAI image_url data URLs to native Anthropic image blocks', () => {
+        const body = toAnthropicRequest({
+            model: 'claude-opus-5',
+            messages: [{ role: 'user', content: [
+                { type: 'text', text: '请看清图片里的字' },
+                { type: 'image_url', image_url: { url: 'data:image/jpeg;base64,QUJDRA==' } },
+            ] }],
+        });
+
+        expect(body.messages[0].content).toEqual([
+            { type: 'text', text: '请看清图片里的字' },
+            { type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: 'QUJDRA==' } },
+        ]);
+        expect(JSON.stringify(body.messages)).not.toContain('data:image/jpeg');
+        for (const mediaType of ['image/png', 'image/gif', 'image/webp']) {
+            const converted = toAnthropicRequest({
+                model: 'claude-opus-5',
+                messages: [{ role: 'user', content: [{ type: 'image_url', image_url: { url: `data:${mediaType};base64,QUJDRA==` } }] }],
+            });
+            expect(converted.messages[0].content[0]).toEqual({
+                type: 'image', source: { type: 'base64', media_type: mediaType, data: 'QUJDRA==' },
+            });
+        }
+    });
+
+    it('supports remote image URLs and safely degrades invalid image values', () => {
+        const remote = toAnthropicRequest({
+            model: 'claude-opus-5',
+            messages: [{ role: 'user', content: [
+                { type: 'image_url', image_url: { url: 'https://example.com/photo.png' } },
+            ] }],
+        });
+        expect(remote.messages[0].content[0]).toEqual({
+            type: 'image', source: { type: 'url', url: 'https://example.com/photo.png' },
+        });
+
+        const invalid = toAnthropicRequest({
+            model: 'claude-opus-5',
+            messages: [{ role: 'user', content: [
+                { type: 'image_url', image_url: { url: 'data:image/svg+xml;base64,PHN2Zz4=' } },
+            ] }],
+        });
+        expect(invalid.messages[0].content[0]).toEqual({
+            type: 'text', text: '[Image attachment unavailable]',
+        });
+        expect(JSON.stringify(invalid.messages)).not.toContain('PHN2Zz4');
+    });
+});
diff --git a/utils/anthropicNative.test.ts b/utils/anthropicNative.test.ts
new file mode 100644
index 0000000..25e7905
--- /dev/null
+++ b/utils/anthropicNative.test.ts
@@ -0,0 +1,155 @@
+import { describe, expect, it } from 'vitest';
+import {
+    anthropicThinkingForModel,
+    fromAnthropicResponse,
+    makeAnthropicToolLoopAssistantMessage,
+    resolveAnthropicMessagesUrl,
+    safeFetchAnthropicAsOpenAI,
+    toAnthropicRequest,
+} from './anthropicNative';
+
+describe('anthropic native adapter', () => {
+    it('resolves a native messages endpoint without duplicating path segments', () => {
+        expect(resolveAnthropicMessagesUrl('https://relay.example/v1')).toBe('https://relay.example/v1/messages');
+        expect(resolveAnthropicMessagesUrl('https://relay.example')).toBe('https://relay.example/v1/messages');
+        expect(resolveAnthropicMessagesUrl('https://relay.example/v1/messages')).toBe('https://relay.example/v1/messages');
+    });
+
+    it('keeps the stable cache breakpoint in system and leaves dynamic content uncached', () => {
+        const body = toAnthropicRequest({
+            model: 'claude-opus-5',
+            max_tokens: 100,
+            cache_control: { type: 'ephemeral', ttl: '1h' },
+            messages: [
+                {
+                    role: 'system',
+                    content: [{
+                        type: 'text',
+                        text: 'stable persona',
+                        cache_control: { type: 'ephemeral' },
+                    }],
+                },
+                { role: 'user', content: 'history' },
+                { role: 'assistant', content: 'reply' },
+                { role: 'system', content: 'current time and retrieved memory' },
+                { role: 'user', content: 'latest turn' },
+            ],
+        });
+
+        expect(body.system).toEqual([{
+            type: 'text',
+            text: 'stable persona',
+            cache_control: { type: 'ephemeral' },
+        }]);
+        expect(body.cache_control).toEqual({ type: 'ephemeral', ttl: '1h' });
+        expect(JSON.stringify(body.messages)).not.toContain('cache_control');
+        expect(JSON.stringify(body.messages)).toContain('current time and retrieved memory');
+        expect(body.stream).toBe(false);
+    });
+
+    it('converts OpenAI tools and Anthropic tool_use responses in both directions', () => {
+        const request = toAnthropicRequest({
+            model: 'claude-opus-5',
+            messages: [{ role: 'user', content: 'search' }],
+            tools: [{
+                type: 'function',
+                function: {
+                    name: 'breath_search',
+                    description: 'search memory',
+                    parameters: { type: 'object', properties: { query: { type: 'string' } } },
+                },
+            }],
+            tool_choice: 'auto',
+        });
+        expect(request.tools[0].name).toBe('breath_search');
+        expect(request.tools[0].input_schema.properties.query.type).toBe('string');
+        expect(request.tool_choice).toEqual({ type: 'auto' });
+
+        const response = fromAnthropicResponse({
+            id: 'msg_1',
+            model: 'claude-opus-5',
+            stop_reason: 'tool_use',
+            content: [{ type: 'tool_use', id: 'toolu_1', name: 'breath_search', input: { query: 'umbrella' } }],
+            usage: {
+                input_tokens: 1000,
+                output_tokens: 20,
+                cache_creation_input_tokens: 800,
+                cache_read_input_tokens: 200,
+            },
+        });
+        expect(response.choices[0].finish_reason).toBe('tool_calls');
+        expect(response.choices[0].message.tool_calls[0].function.arguments).toBe('{"query":"umbrella"}');
+        expect(response.usage.prompt_tokens).toBe(2000);
+        expect(response.usage.total_tokens).toBe(2020);
+        expect(response.usage.cache_creation_input_tokens).toBe(800);
+        expect(response.usage.cache_read_input_tokens).toBe(200);
+    });
+
+    it('omits temperature, forwards native thinking, and chooses the supported thinking form by model', () => {
+        expect(anthropicThinkingForModel('claude-sonnet-4-5')).toEqual({ type: 'enabled', budget_tokens: 4000 });
+        expect(anthropicThinkingForModel('claude-opus-4-6')).toEqual({ type: 'enabled', budget_tokens: 4000 });
