+import type { APIConfig, IndependentTextApiConfig } from '../types';
+
+/** 独立文本 API 只有 URL 和模型都存在时才启用，避免半份配置字段混搭。 */
+export const hasIndependentTextApi = (config?: IndependentTextApiConfig | null): boolean =>
+  !!config?.baseUrl?.trim() && !!config?.model?.trim();
+
+/**
+ * 回退时原样使用聊天主 API；独立启用时，所有文本请求相关字段都来自独立快照。
+ * 空 Key 是有意的独立 Key，绝不能从主 API 借用；Anthropic 缓存只允许在原生协议下生效。
+ */
+export const resolveIndependentTextApi = (
+  main: APIConfig,
+  override?: IndependentTextApiConfig | null,
+): APIConfig => {
+  if (!hasIndependentTextApi(override)) return main;
+  const anthropicNative = !!override!.anthropicNative;
+  return {
+    ...main,
+    baseUrl: override!.baseUrl!.trim(),
+    apiKey: override!.apiKey ?? '',
+    model: override!.model!.trim(),
+    anthropicNative,
+    anthropicPromptCache: anthropicNative && !!override!.anthropicPromptCache,
+    stream: override!.stream ?? false,
+    temperature: override!.temperature,
+  };
+};
