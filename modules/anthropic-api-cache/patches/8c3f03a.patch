diff --git a/utils/anthropicNative.ts b/utils/anthropicNative.ts
new file mode 100644
index 0000000..f3f03af
--- /dev/null
+++ b/utils/anthropicNative.ts
@@ -0,0 +1,120 @@
+import { safeFetchJson, type StreamHooks } from './safeApi';
+import type { ApiCallMeta } from './apiCallLog';
+
+const IMAGE_TYPES = new Set(['image/jpeg', 'image/png', 'image/gif', 'image/webp']);
+// Deliberately non-enumerable: extended-thinking blocks are needed only for the
+// next native tool-loop request. They must never reach UI storage or debug logs.
+const ANTHROPIC_RESPONSE_CONTENT = Symbol('anthropic-response-content');
+
+export const anthropicThinkingForModel = (model: unknown): { type: 'adaptive' } | { type: 'enabled'; budget_tokens: number } => {
+  // The optional minor is a real one-digit model segment (4-7 / 4.7), never
+  // the date in stable names such as claude-opus-4-20250514.
+  const match = String(model || '').match(/claude-[a-z]+-(\d+)(?:[-.](\d)(?=$|-))?/i);
+  const major = Number(match?.[1] || 0);
+  const minor = Number(match?.[2] || 0);
+  // Claude 4.7+ and all later named generations use adaptive thinking. Older
+  // 4.5/4.6 models still require the explicit enabled budget form.
+  return major > 4 || (major === 4 && minor >= 7)
+    ? { type: 'adaptive' }
+    : { type: 'enabled', budget_tokens: 4000 };
+};
+const imageBlock = (value: unknown): any | null => {
+  const url = String(value || '').trim();
+  const data = url.match(/^data:(image\/[a-z0-9.+-]+);base64,([\s\S]+)$/i);
+  if (data && IMAGE_TYPES.has(data[1].toLowerCase()) && data[2].trim()) {
+    return { type: 'image', source: { type: 'base64', media_type: data[1].toLowerCase(), data: data[2].replace(/\s+/g, '') } };
+  }
+  return /^https?:\/\/\S+$/i.test(url) ? { type: 'image', source: { type: 'url', url } } : null;
+};
+
+const blocks = (content: any, allowImages = false): any[] => {
+  if (typeof content === 'string') return [{ type: 'text', text: content }];
+  if (!Array.isArray(content)) return [{ type: 'text', text: String(content ?? '') }];
+  return content.flatMap(part => {
+    if (!part || typeof part !== 'object') return [{ type: 'text', text: String(part ?? '') }];
+    if (part.type === 'text') return [{ type: 'text', text: String(part.text ?? ''), ...(part.cache_control ? { cache_control: part.cache_control } : {}) }];
+    if (part.type === 'image_url') {
+      const image = allowImages ? imageBlock(part.image_url?.url || part.image_url) : null;
+      return image ? [image] : [{ type: 'text', text: '[Image attachment unavailable]' }];
+    }
+    return [{ type: 'text', text: JSON.stringify(part) }];
+  });
+};
+
+const append = (target: any[], role: 'user' | 'assistant', content: any[]) => {
+  const previous = target[target.length - 1];
+  if (previous?.role === role) previous.content.push(...content);
+  else target.push({ role, content: content.length ? content : [{ type: 'text', text: ' ' }] });
+};
+
+export const resolveAnthropicMessagesUrl = (baseUrl: string): string => {
+  const base = baseUrl.trim().replace(/\/+$/, '');
+  if (/\/v1\/messages$/i.test(base) || /\/messages$/i.test(base)) return base;
+  return /\/v1$/i.test(base) ? `${base}/messages` : `${base}/v1/messages`;
+};
+
+export const toAnthropicRequest = (body: any): any => {
+  const source = Array.isArray(body?.messages) ? body.messages : [];
+  const firstSystem = source.findIndex((message: any) => message?.role === 'system');
+  const system = firstSystem >= 0 ? blocks(source[firstSystem].content) : [];
+  const messages: any[] = [];
+  source.forEach((message: any, index: number) => {
+    if (!message) return;
+    if (message.role === 'system') {
+      if (index !== firstSystem) append(messages, 'user', [{ type: 'text', text: `SULLY_INTERNAL_CONTEXT\n${blocks(message.content).map(x => x.text || '').join('\n')}` }]);
+      return;
+    }
+    if (message.role === 'tool') {
+      append(messages, 'user', [{ type: 'tool_result', tool_use_id: message.tool_call_id || message.id || 'unknown_tool_call', content: typeof message.content === 'string' ? message.content : JSON.stringify(message.content ?? '') }]);
+      return;
+    }
+    const nativeContent = message.role === 'assistant' ? message[ANTHROPIC_RESPONSE_CONTENT] : undefined;
+    const content = Array.isArray(nativeContent)
+      ? nativeContent.map((block: any) => ({ ...block }))
+      : blocks(message.content, message.role !== 'assistant');
+    if (message.role === 'assistant' && !nativeContent) for (const call of message.tool_calls || []) {
+      let input: any = call.function?.arguments ?? call.arguments ?? {};
+      if (typeof input === 'string') try { input = input ? JSON.parse(input) : {}; } catch { input = { raw: input }; }
+      content.push({ type: 'tool_use', id: call.id || `toolu_${Math.random().toString(36).slice(2)}`, name: call.function?.name || call.name || '', input });
+    }
+    append(messages, message.role === 'assistant' ? 'assistant' : 'user', content);
+  });
+  if (messages[0]?.role === 'assistant') messages.unshift({ role: 'user', content: [{ type: 'text', text: '(Conversation context follows.)' }] });
+  if (!messages.length) messages.push({ role: 'user', content: [{ type: 'text', text: ' ' }] });
+  const tools = Array.isArray(body?.tools) ? body.tools.filter((tool: any) => tool?.type === 'function' && tool.function?.name).map((tool: any) => ({ name: tool.function.name, ...(tool.function.description ? { description: tool.function.description } : {}), input_schema: tool.function.parameters || { type: 'object', properties: {} } })) : [];
+  const toolChoice = body?.tool_choice === 'auto' || !body?.tool_choice ? { type: 'auto' } : body.tool_choice?.function?.name ? { type: 'tool', name: body.tool_choice.function.name } : undefined;
+  return { model: body.model, max_tokens: body.max_tokens || body.max_completion_tokens || 8000, ...(body?.cache_control ? { cache_control: body.cache_control } : {}), messages, ...(system.length ? { system } : {}), ...(body?.thinking ? { thinking: body.thinking } : {}), ...(tools.length ? { tools } : {}), ...(toolChoice ? { tool_choice: toolChoice } : {}), stream: false };
+};
+
+export const fromAnthropicResponse = (response: any): any => {
+  const content = Array.isArray(response?.content) ? response.content : [];
+  const text = content.filter((x: any) => x?.type === 'text').map((x: any) => x.text || '').join('');
+  const tool_calls = content.filter((x: any) => x?.type === 'tool_use').map((x: any) => ({ id: x.id, type: 'function', function: { name: x.name, arguments: JSON.stringify(x.input || {}) } }));
+  const inputTokens = response?.usage?.input_tokens || 0;
+  const outputTokens = response?.usage?.output_tokens || 0;
+  const cacheCreationInputTokens = response?.usage?.cache_creation_input_tokens || 0;
+  const cacheReadInputTokens = response?.usage?.cache_read_input_tokens || 0;
+  const promptTokens = inputTokens + cacheCreationInputTokens + cacheReadInputTokens;
+  const message: any = { role: 'assistant', content: text, ...(tool_calls.length ? { tool_calls } : {}) };
+  Object.defineProperty(message, ANTHROPIC_RESPONSE_CONTENT, { value: content, enumerable: false });
+  return { id: response?.id || 'anthropic-message', object: 'chat.completion', created: Math.floor(Date.now() / 1000), model: response?.model || '', choices: [{ index: 0, message, finish_reason: response?.stop_reason === 'tool_use' ? 'tool_calls' : 'stop' }], usage: { prompt_tokens: promptTokens, completion_tokens: outputTokens, total_tokens: promptTokens + outputTokens, cache_creation_input_tokens: response?.usage?.cache_creation_input_tokens, cache_read_input_tokens: response?.usage?.cache_read_input_tokens } };
+};
+
+/** Retain native extended-thinking blocks only while the in-memory tool loop continues. */
+export const makeAnthropicToolLoopAssistantMessage = (message: any, toolCalls = message?.tool_calls): any => {
+  const next: any = {
+    role: 'assistant',
+    content: message?.content || '(调用工具中)',
+    ...(toolCalls?.length ? { tool_calls: toolCalls } : {}),
+  };
+  if (message?.[ANTHROPIC_RESPONSE_CONTENT]) {
+    Object.defineProperty(next, ANTHROPIC_RESPONSE_CONTENT, {
+      value: message[ANTHROPIC_RESPONSE_CONTENT],
+      enumerable: false,
+    });
+  }
+  return next;
+};
+
+export const safeFetchAnthropicAsOpenAI = async (baseUrl: string, apiKey: string, body: any, retries = 0, timeoutMs = 0, meta?: ApiCallMeta, hooks?: StreamHooks): Promise<any> =>
+  fromAnthropicResponse(await safeFetchJson(resolveAnthropicMessagesUrl(baseUrl), { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey || 'sk-none', 'anthropic-version': '2023-06-01' }, body: JSON.stringify(toAnthropicRequest(body)) }, retries, timeoutMs, meta, hooks));
