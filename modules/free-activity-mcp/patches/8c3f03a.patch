@@ -0,0 +1,81 @@
+import React, { useEffect, useState } from 'react';
+import type { APIConfig, ApiPreset } from '../../types';
+import { hasFreeActivityApiOverride } from '../../utils/freeActivityApi';
+
+type Draft = Pick<APIConfig, 'baseUrl' | 'apiKey' | 'model'>;
+interface Props {
+  isOpen: boolean;
+  mainApi: APIConfig;
+  savedApi?: Partial<APIConfig>;
+  presets: ApiPreset[];
+  models: string[];
+  onClose: () => void;
+  onSave: (config: Partial<APIConfig> | null) => void;
+}
+const blank: Draft = { baseUrl: '', apiKey: '', model: '' };
+
+const FreeActivityApiSettingsModal: React.FC<Props> = ({ isOpen, mainApi, savedApi, presets, models, onClose, onSave }) => {
+  const [followMain, setFollowMain] = useState(true);
+  const [draft, setDraft] = useState<Draft>(blank);
+  const [testing, setTesting] = useState(false);
+  const [testResult, setTestResult] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setFollowMain(!hasFreeActivityApiOverride(savedApi));
+    setDraft({ baseUrl: savedApi?.baseUrl || '', apiKey: savedApi?.apiKey || '', model: savedApi?.model || '' });
+    setTestResult(null);
+  }, [isOpen, savedApi]);
+
+  if (!isOpen) return null;
+  const effective: APIConfig = followMain ? mainApi : { ...mainApi, ...draft };
+  const inputClass = 'mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs outline-none focus:border-rose-300';
+
+  const test = async () => {
+    if (!effective.baseUrl.trim() || !effective.model.trim()) { setTestResult('请先填写 URL 和 MODEL'); return; }
+    setTesting(true); setTestResult(null);
+    try {
+      const response = await fetch(`${effective.baseUrl.replace(/\/+$/, '')}/chat/completions`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${effective.apiKey || 'sk-none'}` },
+        body: JSON.stringify({ model: effective.model, messages: [{ role: 'user', content: 'Hi' }], max_tokens: 5, stream: false }),
+      });
+      if (!response.ok) {
+        const message = await response.text().catch(() => '');
+        setTestResult(`HTTP ${response.status}: ${message.slice(0, 80)}`);
+      } else {
+        const data = await response.json().catch(() => ({}));
+        const reply = data?.choices?.[0]?.message?.content || '';
+        setTestResult(`连接成功${reply ? ` · ${String(reply).slice(0, 24)}` : ''}`);
+      }
+    } catch (error: any) {
+      setTestResult(`连接失败: ${error?.message || String(error)}`);
+    } finally { setTesting(false); }
+  };
+
+  const save = () => {
+    if (followMain) { onSave(null); return; }
+    if (!draft.baseUrl.trim() || !draft.model.trim()) { setTestResult('独立 API 至少需要填写 URL 和 MODEL'); return; }
+    onSave({ baseUrl: draft.baseUrl.trim(), apiKey: draft.apiKey, model: draft.model.trim() });
+  };
+  const choosePreset = (preset: ApiPreset) => {
+    setFollowMain(false);
+    setDraft({ baseUrl: preset.config.baseUrl || '', apiKey: preset.config.apiKey || '', model: preset.config.model || '' });
+    setTestResult(null);
+  };
+
+  const header = <div className='mb-4 flex justify-between'><h3 className='font-bold'>自由活动 API</h3><button onClick={onClose}>关闭</button></div>;
+  const mode = <div className='grid grid-cols-2 gap-2 rounded-2xl bg-slate-100 p-1'><button type='button' onClick={() => setFollowMain(true)} className={followMain ? 'rounded-xl bg-white px-3 py-2 text-xs font-semibold shadow-sm' : 'rounded-xl px-3 py-2 text-xs text-slate-500'}>跟随聊天 API</button><button type='button' onClick={() => setFollowMain(false)} className={!followMain ? 'rounded-xl bg-white px-3 py-2 text-xs font-semibold text-rose-600 shadow-sm' : 'rounded-xl px-3 py-2 text-xs text-slate-500'}>使用独立 API</button></div>;
+  const presetButtons = presets.map((preset) => <button key={preset.id} type='button' onClick={() => choosePreset(preset)} className='rounded-full border px-3 py-1 text-xs'>{preset.name}</button>);
+  const presetList = presets.length ? <div><p className='mb-2 text-xs text-slate-500'>从已有预设载入</p><div className='flex flex-wrap gap-2'>{presetButtons}</div></div> : null;
+  const urlField = <label className='block text-xs text-slate-500'>URL<input value={draft.baseUrl} onChange={(event) => setDraft((old) => ({ ...old, baseUrl: event.target.value }))} placeholder='https://api.example.com/v1' className={inputClass} /></label>;
+  const keyField = <label className='block text-xs text-slate-500'>KEY<input type='password' value={draft.apiKey} onChange={(event) => setDraft((old) => ({ ...old, apiKey: event.target.value }))} placeholder='可留空' className={inputClass} /></label>;
+  const modelOptions = models.map((model) => <option key={model} value={model} />);
+  const modelField = <label className='block text-xs text-slate-500'>MODEL<input list='free-activity-models' value={draft.model} onChange={(event) => setDraft((old) => ({ ...old, model: event.target.value }))} placeholder='deepseek-chat' className={inputClass} /><datalist id='free-activity-models'>{modelOptions}</datalist></label>;
+  const fields = followMain ? <div className='mt-4 rounded-2xl bg-slate-50 p-4 text-xs'>当前跟随：{mainApi.model || '未配置模型'}</div> : <div className='mt-4 space-y-3'>{presetList}{urlField}{keyField}{modelField}</div>;
+  const result = testResult ? <p className='mt-3 rounded-xl bg-slate-50 px-3 py-2 text-xs'>{testResult}</p> : null;
+  const actions = <div className='mt-5 flex gap-2'><button type='button' onClick={test} disabled={testing} className='flex-1 rounded-2xl border px-4 py-3 text-sm'>{testing ? '测试中…' : '测试连接'}</button><button type='button' onClick={save} className='flex-1 rounded-2xl bg-rose-500 px-4 py-3 text-sm font-semibold text-white'>保存配置</button></div>;
+  return <div className='fixed inset-0 z-[120] flex items-end justify-center bg-slate-950/45 p-3 sm:items-center' onClick={onClose}><section className='max-h-[92vh] w-full max-w-xl overflow-y-auto rounded-3xl bg-white p-5 shadow-2xl' onClick={(event) => event.stopPropagation()}>{header}{mode}{fields}{result}{actions}</section></div>;
+};
+
+export default FreeActivityApiSettingsModal;
