+  | 'auth'
+  | 'network'
+  | 'rate_limit'
+  | 'timeout'
+  | 'validation'
+  | 'server'
+  | 'unknown';
+
+export interface FreeActivityAuditEvent {
+  sessionId: string;
+  callId: string;
+  provider: FreeActivityAuditProvider;
+  action: string;
+  result: FreeActivityAuditResult;
+  startedAt: number;
+  durationMs: number;
+  errorCategory?: FreeActivityAuditErrorCategory;
+}
+
+export interface FreeActivityAuditOptions {
+  sessionId: string;
+  onEvent?: (event: FreeActivityAuditEvent) => void;
+  now?: () => number;
+}
+
+export type FreeActivityAuditCall = <T>(
+  action: string,
+  operation: () => Promise<T>,
+  provider?: FreeActivityAuditProvider,
+) => Promise<T>;
+type ResultLike = { success?: unknown; error?: unknown };
+
+const SAFE_ACTION = /^[a-z][a-z0-9_]{0,63}$/;
+
+export const classifyFreeActivityAuditError = (error: unknown): FreeActivityAuditErrorCategory => {
+  let text = '';
+  try {
+    text = String(error instanceof Error ? error.message : error || '').toLowerCase();
+  } catch {
+    return 'unknown';
+  }
+  if (/401|403|auth|unauthori[sz]ed|forbidden|login|credential/.test(text)) return 'auth';
+  if (/429|rate.?limit|too many/.test(text)) return 'rate_limit';
+  if (/timeout|timed out|abort/.test(text)) return 'timeout';
+  if (/400|404|422|invalid|validation|bad request/.test(text)) return 'validation';
+  if (/5\d\d|server error|internal error/.test(text)) return 'server';
+  if (/network|fetch|socket|connection|econn|dns/.test(text)) return 'network';
+  return 'unknown';
+};
+
+const safeAction = (action: string): string => SAFE_ACTION.test(action) ? action : 'unknown';
+
+/**
+ * Emits metadata only. Arguments, result data, URLs and raw error text are
+ * deliberately absent from the event shape.
+ */
+export const createFreeActivityAudit = ({
+  sessionId,
+  onEvent,
+  now = Date.now,
+}: FreeActivityAuditOptions): FreeActivityAuditCall => {
+  let sequence = 0;
+  return async <T>(
+    action: string,
+    operation: () => Promise<T>,
+    provider: FreeActivityAuditProvider = 'xhs',
+  ): Promise<T> => {
+    const startedAt = now();
+    const callId = `fac_${++sequence}`;
+    const emit = (result: FreeActivityAuditResult, error?: unknown) => {
+      const event: FreeActivityAuditEvent = {
+        sessionId,
+        callId,
+        provider,
+        action: safeAction(action),
+        result,
+        startedAt,
+        durationMs: Math.max(0, now() - startedAt),
+        ...(result === 'failed'
+          ? { errorCategory: classifyFreeActivityAuditError(error) }
+          : {}),
+      };
+      try { onEvent?.(event); } catch { /* Observation must not affect activity. */ }
+    };
+
+    try {
+      const result = await operation();
+      const resultLike = result && typeof result === 'object'
+        ? result as ResultLike
+        : undefined;
+      const failed = resultLike?.success === false;
+      emit(failed ? 'failed' : 'success', failed ? resultLike?.error : undefined);
+      return result;
+    } catch (error) {
+      emit('failed', error);
+      throw error;
+    }
+  };
+};
