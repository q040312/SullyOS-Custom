@@ -0,0 +1,50 @@
+import { describe, expect, it, vi } from 'vitest';
+import { classifyFreeActivityAuditError, createFreeActivityAudit } from './freeActivityAudit';
+
+describe('free activity audit', () => {
+  it('records only safe metadata for a successful call', async () => {
+    const events: unknown[] = [];
+    const now = vi.fn().mockReturnValueOnce(100).mockReturnValueOnce(145);
+    const audit = createFreeActivityAudit({ sessionId: 'session-1', onEvent: event => events.push(event), now });
+    const result = await audit('search', async () => ({ success: true, data: { cookie: 'secret', content: 'private body' } }));
+    expect(result.success).toBe(true);
+    expect(events).toEqual([{
+      sessionId: 'session-1', callId: 'fac_1', provider: 'xhs', action: 'search',
+      result: 'success', startedAt: 100, durationMs: 45,
+    }]);
+    expect(JSON.stringify(events)).not.toMatch(/secret|private body|cookie/i);
+  });
+
+  it('categorizes failures without changing operation behavior', async () => {
+    const events: any[] = [];
+    const audit = createFreeActivityAudit({ sessionId: 's', onEvent: event => events.push(event) });
+    const failed = await audit('browse', async () => ({ success: false, error: 'HTTP 429 token=do-not-log' }));
+    expect(failed).toEqual({ success: false, error: 'HTTP 429 token=do-not-log' });
+    expect(events[0]).toMatchObject({ action: 'browse', result: 'failed', errorCategory: 'rate_limit' });
+    expect(JSON.stringify(events)).not.toContain('do-not-log');
+
+    const original = new Error('cookie=do-not-log timeout');
+    await expect(audit('post', async () => { throw original; })).rejects.toBe(original);
+    expect(events[1]).toMatchObject({ action: 'post', result: 'failed', errorCategory: 'timeout' });
+  });
+
+  it('limits actions and contains observer failures', async () => {
+    expect(classifyFreeActivityAuditError('403 forbidden')).toBe('auth');
+    expect(classifyFreeActivityAuditError('ECONNRESET')).toBe('network');
+    const events: any[] = [];
+    const audit = createFreeActivityAudit({ sessionId: 's', onEvent: event => events.push(event) });
+    await audit('token=never-log', async () => ({ success: true }));
+    expect(events[0].action).toBe('unknown');
+
+    const safeAudit = createFreeActivityAudit({ sessionId: 's', onEvent: () => { throw new Error('observer failed'); } });
+    await expect(safeAudit('search', async () => 'same')).resolves.toBe('same');
+  });
+
+  it('records generic MCP calls without arguments, results or raw errors', async () => {
+    const events: any[] = [];
+    const audit = createFreeActivityAudit({ sessionId: 's', onEvent: event => events.push(event) });
+    await audit('tool_call', async () => ({ success: true, data: 'private result' }), 'mcp');
+    expect(events[0]).toMatchObject({ provider: 'mcp', action: 'tool_call', result: 'success' });
+    expect(JSON.stringify(events)).not.toContain('private result');
+  });
+});
