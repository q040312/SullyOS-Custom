+import type { McpServerConfig, McpToolDef } from './mcpClient';
+
+export interface FreeActivityMcpChoice {
+  mcpServerId?: unknown;
+  mcpToolName?: unknown;
+  mcpArguments?: unknown;
+}
+
+export interface ResolvedFreeActivityMcpChoice {
+  server: McpServerConfig;
+  tool: McpToolDef;
+  args: Record<string, unknown>;
+}
+
+/** Cedar play parameters are game-specific, so read that game's guide before the first play call. */
+export const resolveFreeActivityMcpSetupChoice = (
+  choice: ResolvedFreeActivityMcpChoice,
+): ResolvedFreeActivityMcpChoice | undefined => {
+  let hostname = '';
+  try { hostname = new URL(choice.server.url).hostname.toLowerCase(); }
+  catch { return undefined; }
+  if (hostname !== 'toy.cedarstar.org' || choice.tool.name !== 'play') return undefined;
+
+  const game = typeof choice.args.game === 'string' ? choice.args.game.trim() : '';
+  const guideTool = (choice.server.tools || []).find(tool => tool.name === 'get_guide');
+  if (!game || !guideTool) return undefined;
+  return { server: choice.server, tool: guideTool, args: { game } };
+};
+
+/** Command-style Cedar games expose their exact command language through play(action=help). */
+export const resolveFreeActivityMcpHelpChoice = (
+  choice: ResolvedFreeActivityMcpChoice,
+  guideResult: string,
+): ResolvedFreeActivityMcpChoice | undefined => {
+  let hostname = '';
+  try { hostname = new URL(choice.server.url).hostname.toLowerCase(); }
+  catch { return undefined; }
+  if (hostname !== 'toy.cedarstar.org' || choice.tool.name !== 'play') return undefined;
+
+  const game = typeof choice.args.game === 'string' ? choice.args.game.trim() : '';
+  if (!game || !/\bhelp\b/i.test(guideResult)) {
+    return undefined;
+  }
+
+  const topLevelHelp = /允许动作[^\n]*\bhelp\b/i.test(guideResult)
+    || /action\s*=\s*[']help[']/i.test(guideResult);
+  const args: Record<string, unknown> = topLevelHelp
+    ? { game, action: 'help' }
+    : { game, action: 'cmd', params: { command: 'help' } };
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params)
+    ? choice.args.params as Record<string, unknown>
+    : {};
+  const slot = params.slot ?? choice.args.slot;
+  if (Number.isInteger(slot) && Number(slot) >= 1 && Number(slot) <= 5) {
+    args.params = { ...((args.params as Record<string, unknown> | undefined) || {}), slot };
+  }
+  return { server: choice.server, tool: choice.tool, args };
+};
+
+/** Keep Cedar play calls inside the discovered {game, action, params} envelope. */
+export const normalizeFreeActivityCedarPlayChoice = (
+  choice: ResolvedFreeActivityMcpChoice,
+  commandReference = '',
+): ResolvedFreeActivityMcpChoice => {
+  let hostname = '';
+  try { hostname = new URL(choice.server.url).hostname.toLowerCase(); }
+  catch { return choice; }
+  if (hostname !== 'toy.cedarstar.org' || choice.tool.name !== 'play') return choice;
+
+  const game = typeof choice.args.game === 'string' ? choice.args.game.trim() : '';
+  let action = typeof choice.args.action === 'string' ? choice.args.action.trim().toLowerCase() : '';
+  if (!game || !action) return choice;
+
+  const rawParams = choice.args.params;
+  const params = rawParams && typeof rawParams === 'object' && !Array.isArray(rawParams)
+    ? { ...(rawParams as Record<string, unknown>) }
+    : {};
+  const explicitCommandCandidates = [
+    params.command,
+    params.cmd,
+    choice.args.command,
+    choice.args.cmd,
+    typeof rawParams === 'string' ? rawParams : undefined,
+  ];
+  const explicitCommand = explicitCommandCandidates.find(value => typeof value === 'string' && value.trim());
+  const explicitWords = typeof explicitCommand === 'string' ? explicitCommand.trim().split(/\s+/) : [];
+  const actionWords = action.split(/\s+/);
+  const feedWords = explicitWords[0]?.toLowerCase() === 'feed'
+    ? explicitWords
+    : actionWords[0]?.toLowerCase() === 'feed' ? actionWords : [];
+  const isFeedAction = actionWords[0]?.toLowerCase() === 'feed';
+  const isFeedCommand = action === 'cmd' && explicitWords[0]?.toLowerCase() === 'feed';
+  if (game.toLowerCase() === 'garden_cat' && feedWords.length > 0 && (isFeedAction || isFeedCommand)) {
+    const food = [feedWords[1], params.food_type, params.food, params.type, params.kind]
+      .find(value => typeof value === 'string' && /^(basic|premium)$/i.test(value.trim()));
+    const slot = params.slot ?? choice.args.slot;
+    const commandParams: Record<string, unknown> = {
+      command: `feed ${typeof food === 'string' ? food.trim().toLowerCase() : 'basic'}`,
+    };
+    if (Number.isInteger(slot) && Number(slot) >= 1 && Number(slot) <= 5) {
+      commandParams.slot = slot;
+    }
+    return {
+      ...choice,
+      args: { game, action: 'cmd', params: commandParams },
+    };
+  }
+  const harvestWords = explicitWords[0]?.toLowerCase() === 'harvest'
+    ? explicitWords
+    : actionWords[0]?.toLowerCase() === 'harvest' ? actionWords : [];
+  const isHarvestAction = actionWords[0]?.toLowerCase() === 'harvest';
+  const isHarvestCommand = action === 'cmd' && explicitWords[0]?.toLowerCase() === 'harvest';
+  if (game.toLowerCase() === 'garden_cat' && harvestWords.length > 0 && (isHarvestAction || isHarvestCommand)) {
+    const pot = [harvestWords[1], params.pot, params.pot_number, params.potNumber, params.target]
+      .find(value => (typeof value === 'number' && Number.isInteger(value) && value >= 1 && value <= 3)
+        || (typeof value === 'string' && /^(?:[1-3]|all)$/i.test(value.trim())));
+    const slot = params.slot ?? choice.args.slot;
+    const command = typeof pot === 'number'
+      ? `harvest ${pot}`
+      : typeof pot === 'string' ? `harvest ${pot.trim().toLowerCase()}` : 'harvest';
+    const commandParams: Record<string, unknown> = { command };
+    if (Number.isInteger(slot) && Number(slot) >= 1 && Number(slot) <= 5) {
+      commandParams.slot = slot;
+    }
+    return {
+      ...choice,
+      args: { game, action: 'cmd', params: commandParams },
+    };
+  }
+  let commandFromAction: string | undefined;
+  const directActions = new Set(['new', 'cmd', 'help', 'status', 'export', 'import', 'rest', 'vote']);
+  if (!directActions.has(action) && commandReference) {
+    const commandVerb = action.split(/\s+/, 1)[0];
+    if (/^[a-z][a-z0-9_-]*$/i.test(commandVerb)
+      && new RegExp(`(^|[^a-z_])${commandVerb}(?=$|[^a-z_])`, 'i').test(commandReference)) {
+      commandFromAction = action;
+      action = 'cmd';
+    }
+  }
+  if (action === 'cmd') {
+    const commandCandidates = [
+      params.command,
+      params.cmd,
+      choice.args.command,
+      choice.args.cmd,
+      typeof rawParams === 'string' ? rawParams : undefined,
+      commandFromAction,
+    ];
+    let command = commandCandidates.find(value => typeof value === 'string' && value.trim());
+    if (typeof command !== 'string' && commandReference) {
+      const safeFallback = ['look', 'status', 'help'].find(candidate =>
+        new RegExp(`(^|[^a-z_])${candidate}(?=$|[^a-z_])`, 'i').test(commandReference),
+      );
+      if (safeFallback) command = safeFallback;
+    }
+    if (typeof command === 'string') {
+      const cmdParams: Record<string, unknown> = { command: command.trim() };
+      const slot = params.slot ?? choice.args.slot;
+      if (Number.isInteger(slot) && Number(slot) >= 1 && Number(slot) <= 5) cmdParams.slot = slot;
+      return { ...choice, args: { game, action, params: cmdParams } };
+    }
+  }
+  return {
+    ...choice,
+    args: Object.keys(params).length > 0 ? { game, action, params } : { game, action },
+  };
+};
+
+export const FREE_ACTIVITY_CEDAR_REFERENCE_MAX_CHARS = 4_000;
+export const FREE_ACTIVITY_CEDAR_HISTORY_MAX_ENTRIES = 6;
+export const FREE_ACTIVITY_CEDAR_HISTORY_MAX_CHARS = 1_200;
+export const FREE_ACTIVITY_CEDAR_HISTORY_ENTRY_MAX_CHARS = 200;
+export const FREE_ACTIVITY_AGENT_CONTEXT_MAX_CHARS = 4_000;
+export const FREE_ACTIVITY_AGENT_CONTEXT_MAX_ENTRIES = 6;
+export const FREE_ACTIVITY_MCP_RESULT_SUMMARY_MAX_CHARS = 1_200;
+
+/** Keep model-only summaries free of transport and game-save secrets. */
+export const sanitizeFreeActivityMcpSummaryText = (
+  value: unknown,
+  maxChars = FREE_ACTIVITY_MCP_RESULT_SUMMARY_MAX_CHARS,
+): string => {
+  if (typeof value !== 'string') return '';
+  return value
+    .replace(/[\u0000-\u001f\u007f]/g, ' ')
+    .replace(/\b(?:https?|wss?):\/\/[^\s<>'"\`]+/gi, '[URL]')
+    .replace(/\bBearer\s+[^\s,;]+/gi, 'Bearer [已隐藏]')
+    .replace(/(["']?(?:access_?token|token|auth(?:orization)?|cookie|session(?:_?id)?|api_?key|client_?secret|secret|password|passphrase|key|player_?id|save_?data)["']?\s*[:=]\s*)(?:"[^"]*"|'[^']*'|[^\s,}\]]+)/gi, '$1[已隐藏]')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, maxChars);
+};
+
+/** A Cedar game state must not be shared by another game, save slot, server or character. */
+export const buildFreeActivityCedarGameStateKey = (
+  choice: ResolvedFreeActivityMcpChoice,
+): string => {
+  if (!isFreeActivityCedarPlayTool(choice.server, choice.tool.name)) return '';
+  const game = typeof choice.args.game === 'string' ? choice.args.game.trim().toLowerCase() : '';
+  if (!game) return '';
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params)
+    ? choice.args.params as Record<string, unknown>
+    : {};
+  const rawSlot = params.slot ?? choice.args.slot;
+  const slot = Number.isInteger(rawSlot) && Number(rawSlot) >= 1 && Number(rawSlot) <= 5
+    ? String(rawSlot)
+    : 'default';
+  return `${choice.server.id}::${game}::${slot}`;
+};
+
+/** Cache entries are local conveniences, but must not cross a character or Cedar endpoint boundary. */
+export const buildFreeActivityCedarCatalogCacheKey = (
+  characterId: string,
+  server: Pick<McpServerConfig, 'id' | 'url'>,
+): string => {
+  let url = '';
+  try { url = new URL(server.url).toString().replace(/\/$/, '').toLowerCase(); }
+  catch { url = String(server.url || '').trim().toLowerCase(); }
+  return `${characterId}::${server.id}::${url}`;
+};
+
+export interface FreeActivityAgentContextEntry {
+  call: string;
+  result: string;
+}
+
+/** Bounded run-local context only; neither this list nor its source result may be persisted. */
+export const appendFreeActivityAgentContext = (
+  history: readonly FreeActivityAgentContextEntry[],
+  choice: ResolvedFreeActivityMcpChoice,
+  result: unknown,
+): FreeActivityAgentContextEntry[] => {
+  const call = formatFreeActivityCedarPlayCallSummary(choice)
+    || `${sanitizeFreeActivityMcpSummaryText(choice.server.name, 80)} / ${sanitizeFreeActivityMcpSummaryText(choice.tool.name, 80)}`;
+  const safeResult = sanitizeFreeActivityMcpSummaryText(result);
+  if (!call || !safeResult) return [...history].slice(-FREE_ACTIVITY_AGENT_CONTEXT_MAX_ENTRIES);
+  return [...history, { call, result: safeResult }].slice(-FREE_ACTIVITY_AGENT_CONTEXT_MAX_ENTRIES);
+};
+
+export const buildFreeActivityAgentContext = (
+  objective: unknown,
+  currentCall: string,
+  history: readonly FreeActivityAgentContextEntry[],
+): string => {
+  const objectiveText = sanitizeFreeActivityMcpSummaryText(objective, 360) || '完成当前自由活动';
+  const current = sanitizeFreeActivityMcpSummaryText(currentCall, FREE_ACTIVITY_CEDAR_HISTORY_ENTRY_MAX_CHARS);
+  const entries = history.slice(-FREE_ACTIVITY_AGENT_CONTEXT_MAX_ENTRIES)
+    .map((entry, index) => `${index + 1}. ${sanitizeFreeActivityMcpSummaryText(entry.call, 200)} → ${sanitizeFreeActivityMcpSummaryText(entry.result, 600)}`);
+  let context = [`目标：${objectiveText}`, current && `当前调用：${current}`, entries.length && `已完成动作：\n${entries.join('\n')}`]
+    .filter(Boolean)
+    .join('\n');
+  while (context.length > FREE_ACTIVITY_AGENT_CONTEXT_MAX_CHARS && entries.length > 0) {
+    entries.shift();
+    context = [`目标：${objectiveText}`, current && `当前调用：${current}`, entries.length && `已完成动作：\n${entries.join('\n')}`]
+      .filter(Boolean)
+      .join('\n');
+  }
+  return context.slice(0, FREE_ACTIVITY_AGENT_CONTEXT_MAX_CHARS);
+};
+
+/** Preparation is audited but deliberately excluded from the visible/persisted activity stream. */
+export const isFreeActivityCedarPreparationChoice = (
+  choice: ResolvedFreeActivityMcpChoice,
+): boolean => {
+  let hostname = '';
+  try { hostname = new URL(choice.server.url).hostname.toLowerCase(); }
+  catch { return false; }
+  if (hostname !== 'toy.cedarstar.org') return false;
+  if (choice.tool.name === 'list_games' || choice.tool.name === 'get_guide') return true;
+  if (choice.tool.name !== 'play') return false;
+  const rawParams = choice.args.params;
+  const params = rawParams && typeof rawParams === 'object' && !Array.isArray(rawParams)
+    ? rawParams as Record<string, unknown>
+    : {};
+  const isHelp = (value: unknown) => typeof value === 'string' && value.trim().toLowerCase() === 'help';
+  if (isHelp(choice.args.action)) return true;
+  if (typeof choice.args.action !== 'string' || choice.args.action.trim().toLowerCase() !== 'cmd') return false;
+  return [
+    params.command,
+    params.cmd,
+    choice.args.command,
+    choice.args.cmd,
+    typeof rawParams === 'string' ? rawParams : undefined,
+  ].some(isHelp);
+};
+
+/** Human-readable, value-minimized Cedar action title for a persisted activity card. */
+export const formatFreeActivityCedarActivityTitle = (
+  choice: ResolvedFreeActivityMcpChoice,
+): string => {
+  if (!isFreeActivityCedarPlayTool(choice.server, choice.tool.name)) return `${sanitizeFreeActivityMcpSummaryText(choice.server.name, 80)} · ${sanitizeFreeActivityMcpSummaryText(choice.tool.name, 80)}`;
+  const game = typeof choice.args.game === 'string'
+    ? sanitizeFreeActivityMcpSummaryText(choice.args.game, 60).replace(/[_-]+/g, ' ')
+    : 'Cedar';
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params)
+    ? choice.args.params as Record<string, unknown>
+    : {};
+  const action = typeof params.command === 'string'
+    ? sanitizeFreeActivityMcpSummaryText(params.command, 120)
+    : sanitizeFreeActivityMcpSummaryText(choice.args.action, 80);
+  return `${game || 'Cedar'} · ${action || 'play'}`;
+};
+const normalizeFreeActivityCedarText = (value: string, maxChars = FREE_ACTIVITY_CEDAR_HISTORY_ENTRY_MAX_CHARS): string => value
+  .replace(/[\u0000-\u001f\u007f]/g, ' ')
+  .replace(/\s+/g, ' ')
+  .trim()
+  .slice(0, maxChars);
+
+/** A local-only, value-minimized summary for a Cedar play call in this activity run. */
+export const formatFreeActivityCedarPlayCallSummary = (
+  choice: ResolvedFreeActivityMcpChoice,
+): string => {
+  if (!isFreeActivityCedarPlayTool(choice.server, choice.tool.name)) return '';
+  const game = typeof choice.args.game === 'string'
+    ? normalizeFreeActivityCedarText(choice.args.game, 60)
+    : '';
+  const action = typeof choice.args.action === 'string'
+    ? normalizeFreeActivityCedarText(choice.args.action, 60)
+    : '';
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params)
+    ? choice.args.params as Record<string, unknown>
+    : {};
+  const fields = [
+    game && `game=${game}`,
+    action && `action=${action}`,
+  ].filter(Boolean) as string[];
+  if (typeof params.command === 'string' && params.command.trim()) {
+    fields.push(`command=${normalizeFreeActivityCedarText(params.command, 100)}`);
+  }
