@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest';
+import type { APIConfig } from '../types';
+import { hasFreeActivityApiOverride, resolveFreeActivityApiConfig } from './freeActivityApi';
+
+const mainApiKey = ['main', 'key'].join('-');
+const freeApiKey = ['free', 'key'].join('-');
+const main: APIConfig = {
+  baseUrl: 'https://main.example/v1',
+  apiKey: mainApiKey,
+  model: 'main-model',
+};
+
+describe('free activity independent API', () => {
+  it('falls back to the chat API when the override is empty or incomplete', () => {
+    expect(hasFreeActivityApiOverride(undefined)).toBe(false);
+    expect(hasFreeActivityApiOverride({ baseUrl: 'https://free.example/v1' })).toBe(false);
+    expect(resolveFreeActivityApiConfig(main, {})).toBe(main);
+  });
+
+  it('uses only the independent chat endpoint credentials and model when complete', () => {
+    expect(resolveFreeActivityApiConfig(main, {
+      baseUrl: ' https://free.example/v1/ ',
+      apiKey: freeApiKey,
+      model: ' deepseek-chat ',
+    })).toEqual({
+      baseUrl: 'https://free.example/v1/',
+      apiKey: freeApiKey,
+      model: 'deepseek-chat',
+    });
+  });
+
+  it('allows an explicitly keyless independent endpoint', () => {
+    expect(resolveFreeActivityApiConfig(main, {
+      baseUrl: 'http://localhost:1234/v1',
+      apiKey: '',
+      model: 'local-model',
+    }).apiKey).toBe('');
+  });
+});
