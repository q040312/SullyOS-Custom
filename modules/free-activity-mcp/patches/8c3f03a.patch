+/** Cedar may report a game-level failure as MCP success with {ok:false}. */
+export const isFreeActivityMcpBusinessFailure = (
+  server: McpServerConfig,
+  toolName: string,
+  data: unknown,
+): boolean => {
+  let hostname = '';
+  try { hostname = new URL(server.url).hostname.toLowerCase(); }
+  catch { return false; }
+  if (hostname !== 'toy.cedarstar.org' || toolName !== 'play') return false;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return false;
+  const record = data as Record<string, unknown>;
+  if (record.ok === false) return true;
+  const nested = record.data;
+  return !!nested && typeof nested === 'object' && !Array.isArray(nested)
+    && (nested as Record<string, unknown>).ok === false;
