@@ -0,0 +1,18 @@
+import type { APIConfig } from '../types';
+
+export const hasFreeActivityApiOverride = (
+  config?: Partial<APIConfig> | null,
+): boolean => !!config?.baseUrl?.trim() && !!config?.model?.trim();
+
+export const resolveFreeActivityApiConfig = (
+  main: APIConfig,
+  override?: Partial<APIConfig> | null,
+): APIConfig => {
+  if (!hasFreeActivityApiOverride(override)) return main;
+  return {
+    ...main,
+    baseUrl: override!.baseUrl!.trim(),
+    apiKey: override!.apiKey ?? '',
+    model: override!.model!.trim(),
+  };
+};
