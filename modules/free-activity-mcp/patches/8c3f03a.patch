+export const shouldContinueFreeActivityMcpReaction = (
+  reaction: { continue?: unknown; mcpServerId?: unknown; mcpToolName?: unknown; mcpArguments?: unknown } | null,
+  remainingCalls: number,
+): boolean => {
+  if (!reaction || remainingCalls <= 0 || reaction.continue === false || reaction.continue === 'false') return false;
+  const hasNextChoice = typeof reaction.mcpServerId === 'string' && !!reaction.mcpServerId.trim()
+    && typeof reaction.mcpToolName === 'string' && !!reaction.mcpToolName.trim()
+    && !!reaction.mcpArguments && typeof reaction.mcpArguments === 'object' && !Array.isArray(reaction.mcpArguments);
+  return hasNextChoice && (reaction.continue === undefined || reaction.continue === true || reaction.continue === 'true');
+};
+
+const canonicalizeJson = (value: unknown): unknown => {
+  if (Array.isArray(value)) return value.map(canonicalizeJson);
+  if (!value || typeof value !== 'object') return value;
+  return Object.keys(value as Record<string, unknown>)
+    .sort()
+    .reduce<Record<string, unknown>>((out, key) => {
+      out[key] = canonicalizeJson((value as Record<string, unknown>)[key]);
+      return out;
+    }, {});
+};
+
+export const buildFreeActivityMcpCallFingerprint = (
+  serverId: string,
+  toolName: string,
+  args: Record<string, unknown>,
+  normalizeCedarCommand = false,
+): string => {
+  if (!normalizeCedarCommand) return JSON.stringify([serverId, toolName, canonicalizeJson(args)]);
+  const params = args.params && typeof args.params === 'object' && !Array.isArray(args.params)
+    ? args.params as Record<string, unknown>
+    : undefined;
+  const command = typeof params?.command === 'string'
+    ? params.command.replace(/\s+/g, ' ').trim().toLowerCase()
+    : undefined;
+  const normalizedArgs = command === undefined
+    ? args
+    : { ...args, params: { ...params, command } };
+  return JSON.stringify([serverId, toolName, canonicalizeJson(normalizedArgs)]);
+};
+
+/** Prompt inventory deliberately excludes URLs, tokens, custom headers and proxy credentials. */
+export const buildFreeActivityMcpCatalog = (servers: McpServerConfig[]): string => {
+  const catalog = servers.flatMap(server => {
+    let hostname = '';
+    try { hostname = new URL(server.url).hostname.toLowerCase(); } catch { /* non-Cedar remains unchanged */ }
+    return (server.tools || [])
+      .filter(tool => hostname !== 'toy.cedarstar.org' || (tool.name !== 'list_games' && tool.name !== 'get_guide'))
+      .map(tool => ({
+        serverId: server.id,
+        serverName: server.name,
+        toolName: tool.name,
+        description: tool.description || '',
+        inputSchema: tool.inputSchema || { type: 'object', properties: {} },
+      }));
+  });
+  return catalog.length > 0 ? JSON.stringify(catalog, null, 2) : '';
+};
+
+const hasUnsafeKey = (value: unknown): boolean => {
+  if (!value || typeof value !== 'object') return false;
+  if (Array.isArray(value)) return value.some(hasUnsafeKey);
+  return Object.entries(value as Record<string, unknown>).some(([key, child]) =>
+    key === '__proto__' || key === 'prototype' || key === 'constructor' || hasUnsafeKey(child),
+  );
+};
+
+export const resolveFreeActivityMcpChoice = (
+  servers: McpServerConfig[],
+  choice: FreeActivityMcpChoice,
+): { value?: ResolvedFreeActivityMcpChoice; error?: string } => {
+  const serverId = typeof choice.mcpServerId === 'string' ? choice.mcpServerId.trim() : '';
+  const toolName = typeof choice.mcpToolName === 'string' ? choice.mcpToolName.trim() : '';
+  const server = servers.find(item => item.id === serverId);
+  if (!server) return { error: '所选 MCP 服务器不在当前角色的可用范围内' };
+  const tool = (server.tools || []).find(item => item.name === toolName);
+  if (!tool) return { error: '所选 MCP 工具未被当前服务器发现' };
+
+  const rawArgs = choice.mcpArguments ?? {};
+  if (!rawArgs || typeof rawArgs !== 'object' || Array.isArray(rawArgs)) {
+    return { error: 'MCP 工具参数必须是 JSON 对象' };
+  }
+  let serialized: string;
+  try { serialized = JSON.stringify(rawArgs); }
+  catch { return { error: 'MCP 工具参数无法序列化' }; }
+  if (serialized.length > FREE_ACTIVITY_MCP_ARGS_MAX_CHARS) {
+    return { error: 'MCP 工具参数过长' };
+  }
+  const args = JSON.parse(serialized) as Record<string, unknown>;
+  if (hasUnsafeKey(args)) return { error: 'MCP 工具参数包含不安全字段' };
+  return { value: { server, tool, args } };
+};
+
+export interface FreeActivityCedarProgressSnapshot {
+  location?: string; clues?: string; key?: string; npc?: string; dialogue?: string; board?: string; resources?: string; turn?: string;
+  /** Value-minimized, bounded fingerprint of textual facts; never the raw response. */
+  factSignature?: string;
+  rejected: boolean;
+  reliable: boolean;
+}
+export type FreeActivityCedarProgressResult = 'progress' | 'unchanged' | 'unknown';
+export interface FreeActivityCedarProgressState { baseline?: FreeActivityCedarProgressSnapshot; unchangedCount: number; }
+
+const FREE_ACTIVITY_PROGRESS_MAX_DEPTH = 4;
+const FREE_ACTIVITY_PROGRESS_MAX_JSON_CHARS = 12_000;
+const FREE_ACTIVITY_PROGRESS_MAX_TEXT_CHARS = 700;
+const FREE_ACTIVITY_PROGRESS_SENSITIVE_KEY = /(?:token|cookie|password|secret|player_?id|save_?data|authorization|session|api_?key)/i;
+const FREE_ACTIVITY_PROGRESS_KEYS = new Set(['location', 'loc', 'scene', 'clues', 'clue', 'key', 'keys', 'npc', 'dialogue', 'dialog', 'board', 'quest', 'quests', 'task', 'tasks', 'resources', 'resource', 'inventory', 'items', 'turn', 'round']);
+
+const normalizeFreeActivityProgressValue = (value: unknown, maxChars = 180): string => {
+  if (typeof value === 'number' || typeof value === 'boolean') return String(value);
+  if (typeof value !== 'string' || /\b(?:https?|wss?):\/\//i.test(value)) return '';
+  return sanitizeFreeActivityMcpSummaryText(value, maxChars);
+};
+const hashFreeActivityProgressFact = (value: string): string => {
+  let hash = 0x811c9dc5;
+  for (let index = 0; index < value.length; index++) { hash ^= value.charCodeAt(index); hash = Math.imul(hash, 0x01000193); }
+  return (hash >>> 0).toString(36);
+};
+
+const summarizeFreeActivityProgressResource = (value: unknown): string => {
+  if (!value || typeof value !== 'object') return '';
+  const entries = Array.isArray(value) ? value.slice(0, 8).map((item, index) => [String(index), item] as const) : Object.entries(value as Record<string, unknown>).slice(0, 8);
+  return entries.map(([key, item]) => {
+    if (FREE_ACTIVITY_PROGRESS_SENSITIVE_KEY.test(key) || /url/i.test(key)) return '';
+    const detail = typeof item === 'string' || typeof item === 'number' || typeof item === 'boolean' ? normalizeFreeActivityProgressValue(item, 60) : '';
+    return detail ? `${key}=${detail}` : key;
+  }).filter(Boolean).join(',').slice(0, 180);
+};
+
+/** Extract bounded state signals; credentials, identity, save data, URLs and raw responses are excluded. */
+export const extractFreeActivityCedarProgressSnapshot = (data: unknown): FreeActivityCedarProgressSnapshot => {
+  const values: Partial<Record<'location' | 'clues' | 'key' | 'npc' | 'dialogue' | 'board' | 'resources' | 'turn', string>> = {};
+  const textParts: string[] = [];
+  const seen = new Set<unknown>();
+  const visit = (value: unknown, depth: number, key = ''): void => {
+    if (depth > FREE_ACTIVITY_PROGRESS_MAX_DEPTH || value == null) return;
+    if (typeof value === 'string') {
+      const rawText = value.slice(-FREE_ACTIVITY_PROGRESS_MAX_JSON_CHARS);
+      const statMatch = rawText.match(/📊\s*(\{[\s\S]{1,1200}\})\s*$/);
+      const text = normalizeFreeActivityProgressValue(value, FREE_ACTIVITY_PROGRESS_MAX_TEXT_CHARS);
+      if (!text) return;
+      if (key === 'text' || key === 'message' || key === 'description' || key === 'scene') textParts.push(text);
+      if (statMatch) { try { visit(JSON.parse(statMatch[1]), depth + 1); } catch { /* malformed embedded JSON */ } }
+      if (value.length <= FREE_ACTIVITY_PROGRESS_MAX_JSON_CHARS && /^[\s\[{]/.test(value)) { try { visit(JSON.parse(value), depth + 1); } catch { /* ordinary text */ } }
+      return;
+    }
+    if (typeof value !== 'object' || seen.has(value)) return;
+    seen.add(value);
+    if (Array.isArray(value)) { value.slice(0, 16).forEach(item => visit(item, depth + 1)); return; }
+    Object.entries(value as Record<string, unknown>).slice(0, 32).forEach(([rawKey, item]) => {
+      const normalizedKey = rawKey.toLowerCase().replace(/[\s-]+/g, '_');
+      if (FREE_ACTIVITY_PROGRESS_SENSITIVE_KEY.test(normalizedKey) || /url/i.test(normalizedKey)) return;
+      const mappedKey = normalizedKey === 'loc' || normalizedKey === 'scene' ? 'location' : normalizedKey === 'clue' ? 'clues' : normalizedKey === 'keys' ? 'key' : normalizedKey === 'dialog' ? 'dialogue' : /^(quest|quests|task|tasks)$/.test(normalizedKey) ? 'board' : /^(resource|items|inventory)$/.test(normalizedKey) ? 'resources' : normalizedKey;
+      if (FREE_ACTIVITY_PROGRESS_KEYS.has(normalizedKey) && values[mappedKey as keyof typeof values] === undefined) {
+        const normalized = normalizeFreeActivityProgressValue(item) || (mappedKey === 'resources' ? summarizeFreeActivityProgressResource(item) : '');
+        if (normalized) values[mappedKey as keyof typeof values] = normalized;
+      }
+      visit(item, depth + 1, normalizedKey);
+    });
+  };
+  visit(data, 0);
+  const factText = textParts.join(' ').replace(/📊\s*\{[\s\S]{0,1200}\}\s*$/g, '').replace(/\s+/g, ' ').trim().slice(0, FREE_ACTIVITY_PROGRESS_MAX_TEXT_CHARS);
+  const rejected = /你没有看到|也许换个说法|没有找到|无法找到|无效(?:的)?(?:目标|指令|操作)/.test(factText);
+  const factSignature = factText && !rejected ? hashFreeActivityProgressFact(factText) : undefined;
+  const reliable = !!(values.location || values.clues || values.key || values.npc || values.dialogue || values.board || values.resources || factSignature || rejected);
+  return { ...values, factSignature, rejected, reliable };
+};
+
+const freeActivityProgressValueChanged = (previous?: string, next?: string): boolean => {
+  if (!next || previous === next) return false;
+  return previous !== next;
+};
+/** Turn/round alone is deliberately not progress; unknown results never become a false stall. */
+export const compareFreeActivityCedarProgress = (previous: FreeActivityCedarProgressSnapshot | undefined, next: FreeActivityCedarProgressSnapshot): FreeActivityCedarProgressResult => {
+  if (!previous || !previous.reliable || !next.reliable) return 'unknown';
+  if (next.rejected) return 'unchanged';
+  const fields: Array<keyof Pick<FreeActivityCedarProgressSnapshot, 'location' | 'clues' | 'key' | 'npc' | 'dialogue' | 'board' | 'resources' | 'factSignature'>> = ['location', 'clues', 'key', 'npc', 'dialogue', 'board', 'resources', 'factSignature'];
+  if (fields.some(field => freeActivityProgressValueChanged(previous[field], next[field]))) return 'progress';
+  return fields.every(field => previous[field] === next[field]) ? 'unchanged' : 'unknown';
+};
+/** Applies the two-strike stop rule while keeping state local to one Cedar gameKey. */
+export const advanceFreeActivityCedarProgress = (state: FreeActivityCedarProgressState | undefined, snapshot: FreeActivityCedarProgressSnapshot, refreshOnly = false): { state: FreeActivityCedarProgressState; result: FreeActivityCedarProgressResult; requireDifferentAction: boolean; stop: boolean } => {
+  const prior = state || { unchangedCount: 0 };
+  const result = refreshOnly ? 'unknown' : compareFreeActivityCedarProgress(prior.baseline, snapshot);
+  const unchangedCount = refreshOnly || result === 'unknown' ? prior.unchangedCount : result === 'progress' ? 0 : prior.unchangedCount + 1;
+  return { state: { baseline: snapshot.reliable ? snapshot : prior.baseline, unchangedCount }, result, requireDifferentAction: unchangedCount === 1 && result === 'unchanged', stop: unchangedCount >= 2 && result === 'unchanged' };
+};
+/** Help/status are observations, not substantive actions for the stop rule. */
+export const isFreeActivityCedarProgressAction = (choice: ResolvedFreeActivityMcpChoice): boolean => {
+  if (!isFreeActivityCedarPlayTool(choice.server, choice.tool.name)) return false;
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params) ? choice.args.params as Record<string, unknown> : {};
+  const command = typeof params.command === 'string' ? params.command.trim().toLowerCase() : '';
+  return choice.args.action !== 'status' && choice.args.action !== 'help' && command !== 'status' && command !== 'help';
+};
+
+export type FreeActivityCedarCommandCategory = 'observe' | 'dialogue' | 'move' | 'query' | 'interact';
+export const classifyFreeActivityCedarProgressAction = (choice: ResolvedFreeActivityMcpChoice): FreeActivityCedarCommandCategory | undefined => {
+  if (!isFreeActivityCedarProgressAction(choice)) return undefined;
+  const params = choice.args.params && typeof choice.args.params === 'object' && !Array.isArray(choice.args.params) ? choice.args.params as Record<string, unknown> : {};
+  const raw = typeof params.command === 'string' ? params.command : typeof choice.args.action === 'string' ? choice.args.action : '';
+  const verb = raw.trim().toLowerCase().split(/\s+/, 1)[0];
+  if (/^look/.test(verb)) return 'observe';
+  if (/^(talk|ask)$/.test(verb)) return 'dialogue';
+  if (verb === 'go') return 'move';
+  if (/^(status|help|clues|hint|inventory)$/.test(verb)) return 'query';
+  return 'interact';
+};
