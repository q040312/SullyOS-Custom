+/** Surface only a short Cedar game error, never the full tool response. */
+export const getFreeActivityMcpBusinessFailureMessage = (data: unknown): string => {
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return '';
+  const record = data as Record<string, unknown>;
+  const nested = record.data && typeof record.data === 'object' && !Array.isArray(record.data)
+    ? record.data as Record<string, unknown>
+    : undefined;
+  const candidates = [record.message, record.error, record.detail, nested?.message, nested?.error, nested?.detail];
+  const message = candidates.find(value => typeof value === 'string' && value.trim());
+  return typeof message === 'string'
+    ? message.replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 200)
+    : '';
+};
+
+export const getFreeActivityMcpSafeErrorMessage = (error: unknown): string => typeof error === 'string'
