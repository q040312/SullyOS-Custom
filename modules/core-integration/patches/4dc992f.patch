+import { describe, expect, it } from 'vitest';
+import { createSullyDeploymentUrlsPolicy } from './deploymentUrls';
+
+const storage = () => {
+  const values = new Map<string, string>();
+  return {
+    getItem: (key: string) => values.get(key) || null,
+    setItem: (key: string, value: string) => values.set(key, value),
+    removeItem: (key: string) => values.delete(key),
+  };
+};
+
+describe('shared deployment URL policy', () => {
+  it('keeps web services same-origin by default', () => {
+    const policy = createSullyDeploymentUrlsPolicy('');
+    expect(policy.isApkBuild).toBe(false);
+    expect(policy.memoryUrl).toBe('/sully-memory');
+    expect(policy.credentials).toBe('same-origin');
+    expect(policy.resolveOmbreMemoryUrl(' https://ombre.example/path/ ')).toBe('https://ombre.example/path');
+    expect(policy.authHeaders()).toEqual({});
+  });
+
+  it('pins APK Ombre before attaching its access token', () => {
+    const policy = createSullyDeploymentUrlsPolicy('https://owned.example/', storage());
+    policy.setToken(' private-token ');
+    expect(policy.resolveOmbreMemoryUrl('https://untrusted.example/ombre')).toBe('https://owned.example/sully-app-memory');
+    expect(policy.authHeaders()).toEqual({ Authorization: 'Bearer private-token' });
+    expect(policy.credentials).toBe('omit');
+  });
+});
diff --git a/utils/deploymentUrls.ts b/utils/deploymentUrls.ts
