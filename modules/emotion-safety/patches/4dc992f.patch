new file mode 100644
index 0000000..c9451bf
--- /dev/null
+++ b/utils/emotionBuff.ts
@@ -0,0 +1,40 @@
+import type { CharacterBuff } from '../types';
+
+const clampIntensity = (value: unknown): 1 | 2 | 3 => {
+    const parsed = Number(value);
+    if (!Number.isFinite(parsed)) return 2;
+    if (parsed <= 1) return 1;
+    if (parsed >= 3) return 3;
+    return 2;
+};
+
+const MAX_LABEL_LENGTH = 24;
+
+// Buff labels are model-adjacent data. Reject control/newline-bearing input instead of
+// repairing it into prompt text; a clean name remains a safe fallback for a bad label.
+const normalizeLabel = (value: unknown): string => {
+    if (typeof value !== 'string' || /[\u0000-\u001F\u007F-\u009F]/.test(value)) return '';
+    return value.replace(/\s+/g, ' ').trim().slice(0, MAX_LABEL_LENGTH);
+};
+
+/** Build the only abstract emotion text allowed to persist across chat turns. */
+export function buildEmotionBuffInjection(buffs?: CharacterBuff[]): string {
+    if (!Array.isArray(buffs) || buffs.length === 0) return '';
+    const lines = buffs
+        .filter(Boolean)
+        .slice(0, 5)
+        .map((buff) => {
+            const label = normalizeLabel(buff.label) || normalizeLabel(buff.name);
+            return label ? `- ${label}（强度 ${clampIntensity(buff.intensity)}/3）` : '';
+        })
+        .filter(Boolean);
+    if (lines.length === 0) return '';
+    return [
+        '### [当前情绪底色·全局短期状态]',
+        ...lines,
+        '',
+        '这些 Buff 只影响此刻的语气、主动程度和回应策略。',
+        '不要复述 Buff 标签，也不要把触发它们的旧事件、物件、姿势、动作或临时场景带进当前回复。',
+        '具体事实只以当前对话或当前模式提供的上下文为准；缺少新依据时，不补全触发原因。',
+    ].join('\n');
+}
