+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+const source = readFileSync(fileURLToPath(new URL('../hooks/useChatAI.ts', import.meta.url)), 'utf8');
+
+describe('emotion/AMSG race guard', () => {
+  it('reads DB only inside the active AMSG gate and reuses one live config', () => {
+    const start = source.indexOf('// 满血主动消息：一轮聊完把该角色标脏');
+    const end = source.indexOf('// Memory Palace — 后台缓冲区处理', start);
+    expect(start).toBeGreaterThan(-1);
+    expect(end).toBeGreaterThan(start);
+    const tail = source.slice(start, end);
+    expect(tail).toContain('const liveAmsgConfig = amsg2Session.getConfig();');
+    expect(tail).toContain('if (liveAmsgConfig?.enabled && hasActiveAiTask(liveAmsgConfig))');
+    expect(tail.indexOf('await DB.getAllCharacters()')).toBeGreaterThan(tail.indexOf('if (liveAmsgConfig?.enabled'));
+    expect(tail).toContain('persistedChars.find((candidate) => candidate.id === char.id)');
+    expect(tail).toContain('charRef.current?.id === char.id ? charRef.current : char');
+    expect(tail).toContain('char: { ...amsgLiveChar, activeMsg2Config: liveAmsgConfig }');
+    expect(tail.match(/amsg2Session\.getConfig\(\)/g)).toHaveLength(1);
+    expect(tail).not.toContain('char: { ...char, activeMsg2Config:');
+  });
+});
